---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import { version } from '../../package.json';
import '../styles/global.css';
import '../styles/legacy-layout.css';
import AmbientScene from '../components/AmbientScene.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  quickNavigation?: { href: string; label: string; description?: string }[];
  articleMetadata?: { publishedTime: string; modifiedTime: string; author: string; structuredData: Record<string, unknown> };
}

const {
  title,
  description = siteConfig.description,
  image,
  bodyClass = '',
  quickNavigation = [],
  articleMetadata,
} = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.name;
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl);
const sharingImage = image || '/media/anime/hero/1719656915755.webp';

---

<!doctype html>
<html lang="zh-CN" data-theme="dark" data-reading-font-storage-key={articleMetadata ? siteConfig.articleReading.fontPreferenceStorageKey : undefined}
  data-reading-typography={articleMetadata ? JSON.stringify({ storageKey: siteConfig.articleReading.typographyStorageKey, minimum: siteConfig.articleReading.fontSizeMinimum, maximum: siteConfig.articleReading.fontSizeMaximum, step: siteConfig.articleReading.fontSizeStep }) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202123" data-theme-color />
    <link rel="icon" href="/media/brand/logo.jpg" type="image/jpeg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="SamsBlog RSS" href="/rss.xml" />
    <link rel="expect" href="#page-content-ready" blocking="render" />
    {articleMetadata && image && <link rel="preload" as="image" href={image} referrerpolicy="no-referrer" fetchpriority="high" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleMetadata ? 'article' : 'website'} />
    {articleMetadata && <>
      <meta property="article:published_time" content={articleMetadata.publishedTime} />
      <meta property="article:modified_time" content={articleMetadata.modifiedTime} />
      <meta property="article:author" content={articleMetadata.author} />
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleMetadata.structuredData).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029')} />
    </>}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(sharingImage, siteConfig.siteUrl)} />
    <title>{pageTitle}</title>
    <script is:inline src={`/scripts/page-presentation.js?v=${version}`} {...{ blocking: 'render' }}></script>
  </head>
  <body class={bodyClass} data-reveal-config={!bodyClass.includes('admin-page') ? JSON.stringify(siteConfig.reveal) : undefined}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    {!bodyClass.includes('admin-page') && <div class="reading-progress" aria-hidden="true" data-reading-progress hidden></div>}
    {!bodyClass.includes('admin-page') && <AmbientScene />}
    <Header showMotion={!bodyClass.includes('admin-page')} />
    <main id="main-content" tabindex="-1">
      {quickNavigation.length > 0 && <nav class:list={['home-quick-nav', { visible: !bodyClass.includes('home-page') }]} aria-label={`${title || '首页'}快捷导航`} aria-hidden={bodyClass.includes('home-page')} inert={bodyClass.includes('home-page')} data-quick-nav data-reveal-after-hero={String(bodyClass.includes('home-page'))} data-activation-ratio={siteConfig.navigation.sectionActivationRatio}>
        {quickNavigation.map((item) => <a href={item.href} aria-label={item.description || item.label}><span>{item.label}</span><i></i></a>)}
      </nav>}
      <slot />
      <span id="page-content-ready" hidden></span>
    </main>
    <Footer showSignature={!bodyClass.includes('admin-page')} />
    {!bodyClass.includes('admin-page') && <div id="site-tooltip" class="site-tooltip" popover="manual" role="tooltip"></div>}
    <script>
      import { initializePageView } from '../lib/page-view';
      initializePageView();
      import { animateMotion as animate, createCharacters, animateCharacters } from '../lib/motion';
      import { createTooltip } from '../lib/tooltip';
      // 返回链接走原历史记录，保留文章列表的筛选结果及滚动位置。
      const pageNavigation = (window as Window & { navigation?: { currentEntry?: { key: string }; entries(): { key: string }[]; traverseTo(key: string): unknown } }).navigation;
      try {
        const restore = JSON.parse(sessionStorage.getItem('article-list-return') || 'null');
        if (restore?.url === location.href && Number.isFinite(restore.scrollY)) {
          sessionStorage.removeItem('article-list-return');
          requestAnimationFrame(() => window.scrollTo({ top: restore.scrollY, behavior: 'instant' }));
        }
      } catch (error) { console.warn('Article list position unavailable', error); }
      document.querySelectorAll<HTMLAnchorElement>('a.article-card__link').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          try { sessionStorage.setItem('article-return', JSON.stringify({ article: new URL(link.href).pathname, from: location.href, key: pageNavigation?.currentEntry?.key, scrollY: window.scrollY })); }
          catch (error) { console.warn('Article return state unavailable', error); }
        });
      });
      const back = document.querySelector<HTMLAnchorElement>('.article-reading__back');
      if (back) {
        try {
          const pending = JSON.parse(sessionStorage.getItem('article-return') || 'null');
          if (pending?.article === location.pathname) {
            const from = new URL(pending.from);
            if (from.origin === location.origin && ['/', '/content'].includes(from.pathname)) {
              history.replaceState({ ...history.state, articleReturn: { url: from.href, key: pending.key, scrollY: pending.scrollY } }, '');
            }
            sessionStorage.removeItem('article-return');
          }
          const returnState = history.state?.articleReturn;
          const from = returnState && new URL(typeof returnState === 'string' ? returnState : returnState.url);
          if (from && from.origin === location.origin && ['/', '/content'].includes(from.pathname)) {
            back.href = from.href;
            back.addEventListener('click', (event) => {
              if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
              if (returnState.key && pageNavigation?.entries().some((entry) => entry.key === returnState.key)) {
                event.preventDefault();
                pageNavigation.traverseTo(returnState.key);
              } else if (Number.isFinite(returnState.scrollY)) {
                try { sessionStorage.setItem('article-list-return', JSON.stringify({ url: from.href, scrollY: returnState.scrollY })); }
                catch (error) { console.warn('Article list position save failed', error); }
              }
            });
          }
        } catch (error) { console.warn('Article return state unavailable', error); }
      }
      // 首页和关于页共用区块定位、光晕扩散与疏密交互。
      document.querySelectorAll<HTMLElement>('[data-quick-nav]').forEach((quickNav) => {
        const quickNavItems = [...(quickNav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') || [])].flatMap((link) => {
          const section = document.getElementById(link.hash.slice(1));
          return section ? [{ link, section }] : [];
        });
        let hoveredNavigation: number | null = null;
        let focusedNavigation: number | null = null;
        let quickNavFrame = 0;
        const updateQuickNav = () => {
          quickNavFrame = 0;
          const visible = quickNav.dataset.revealAfterHero !== 'true' || window.scrollY > Math.min(window.innerHeight * 0.55, 520);
          quickNav.classList.toggle('visible', visible);
          quickNav.setAttribute('aria-hidden', String(!visible));
          quickNav.toggleAttribute('inert', !visible);
          const activationLine = window.innerHeight * Number(quickNav.dataset.activationRatio);
          let currentIndex = 0;
          quickNavItems.forEach(({ section }, index) => {
            if (section.getBoundingClientRect().top <= activationLine) currentIndex = index;
          });
          if (window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1) currentIndex = quickNavItems.length - 1;
          if (quickNav.dataset.revealAfterHero === 'true') {
            const section = quickNavItems[currentIndex]?.section.id;
            const atmosphere = section === 'projects' ? 'blue' : section === 'latest-article' ? 'pink' : 'neutral';
            if (document.body.dataset.homeAtmosphere !== atmosphere) document.body.dataset.homeAtmosphere = atmosphere;
          }
          const spacingIndex = hoveredNavigation ?? focusedNavigation ?? currentIndex;
          quickNavItems.forEach(({ link }, index) => {
            if (index === currentIndex) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
            const distance = index - spacingIndex;
            link.style.setProperty('--nav-distance', String(Math.abs(distance)));
            link.style.setProperty('--nav-direction', String(Math.sign(distance)));
            link.dataset.proximity = distance === 0 ? 'active' : Math.abs(distance) === 1 ? 'near' : 'far';
          });
        };
        const scheduleQuickNav = () => {
          if (quickNavFrame) return;
          quickNavFrame = window.requestAnimationFrame(updateQuickNav);
        };
        window.addEventListener('scroll', scheduleQuickNav, { passive: true });
        window.addEventListener('resize', scheduleQuickNav);
        quickNavItems.forEach(({ link }, index) => {
          link.addEventListener('pointerenter', () => { hoveredNavigation = index; scheduleQuickNav(); });
          link.addEventListener('pointerleave', () => { hoveredNavigation = null; scheduleQuickNav(); });
          link.addEventListener('focus', () => { focusedNavigation = index; scheduleQuickNav(); });
          link.addEventListener('blur', () => { focusedNavigation = null; scheduleQuickNav(); });
        });
        const mainContent = document.querySelector('main');
        if (mainContent) new ResizeObserver(scheduleQuickNav).observe(mainContent);
        updateQuickNav();
      });
      // 公开页的即时悬停与键盘提示，统一使用主题面板。
      const tooltip = document.querySelector<HTMLElement>('#site-tooltip');
      if (tooltip) {
        const tooltipController = createTooltip(tooltip, {
          show(trigger) {
            tooltip.textContent = trigger.dataset.tooltip || '';
            const descriptions = new Set((trigger.getAttribute('aria-describedby') || '').split(' ').filter(Boolean));
            descriptions.add('site-tooltip');
            trigger.setAttribute('aria-describedby', [...descriptions].join(' '));
          },
          hide(trigger) {
            const descriptions = (trigger.getAttribute('aria-describedby') || '').split(' ').filter((id) => id && id !== 'site-tooltip');
            if (descriptions.length) trigger.setAttribute('aria-describedby', descriptions.join(' '));
            else trigger.removeAttribute('aria-describedby');
          },
        });
        document.querySelectorAll<HTMLElement>('[data-tooltip]').forEach((trigger) => tooltipController.bind(trigger));
      }

      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      if (progress) {
        const prose = document.querySelector<HTMLElement>('[data-article-prose]');
        let progressFrame = 0;
        const updateProgress = () => {
          progressFrame = 0;
          const distance = document.documentElement.scrollHeight - window.innerHeight;
          let fraction = distance > 0 ? window.scrollY / distance : 1;
          if (prose) {
            const bounds = prose.getBoundingClientRect();
            const offset = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) + 24;
            fraction = Math.max(0, Math.min(1, (offset - bounds.top) / Math.max(1, bounds.height - window.innerHeight + offset)));
          }
          progress.style.setProperty('--reading-progress', String(fraction));
        };
        const scheduleProgress = () => {
          if (!progressFrame) progressFrame = requestAnimationFrame(updateProgress);
        };
        progress.hidden = false;
        window.addEventListener('scroll', scheduleProgress, { passive: true });
        window.addEventListener('resize', scheduleProgress);
        if (prose) new ResizeObserver(scheduleProgress).observe(prose);
        updateProgress();
      }
      // 区块渐入共用一次性观察；历史返回直接显示，避免重复播放入场动效。
      const revealMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const revealIsDisabled = () => revealMotion.matches || document.documentElement.classList.contains('motion-paused');
      const revealConfiguration = document.body.dataset.revealConfig;
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (revealConfiguration && navigation?.type !== 'back_forward' && !revealIsDisabled() && 'IntersectionObserver' in window) {
        const configuration = JSON.parse(revealConfiguration) as {
          durationMilliseconds: number; distancePixels: number; itemStaggerMilliseconds: number;
          maximumStaggerMilliseconds: number; characterDurationMilliseconds: number;
          characterStaggerMilliseconds: number; visibilityThreshold: number; bottomInsetPercent: number;
        };
        const easing = getComputedStyle(document.documentElement).getPropertyValue('--ease-out').trim();
        const itemSelector = '.project-list > article:not([data-project-extra]), .article-card, .friend-card, .about-link, .contribution-panel, .message-form, .message-item, .site-stats dl > div, .sponsor-smile, .article-reading__footer';
        document.querySelectorAll<HTMLElement>(itemSelector).forEach((item) => {
          item.setAttribute('data-reveal', 'item');
        });
        document.querySelectorAll<HTMLElement>('.section-kicker, .home-content-group__heading, .home-guestbook__header > span, .about-section-heading > span, .sponsor-copy > span').forEach((kicker) => {
          kicker.setAttribute('data-reveal', 'kicker');
        });
        document.querySelectorAll<HTMLElement>('.section-title, .home-guestbook__header h2, .about-section-heading h1, .about-section-heading h2, .sponsor-copy h2').forEach((heading) => {
          if (heading.children.length) return;
          const text = heading.textContent || '';
          heading.setAttribute('aria-label', text);
          heading.replaceChildren(...createCharacters(text));
          heading.setAttribute('data-reveal', 'heading');
        });
        const revealTargets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const target = entry.target as HTMLElement;
            target.classList.remove('reveal-pending');
            observer.unobserve(entry.target);
            if (revealIsDisabled() || target.dataset.reordered || document.documentElement.dataset.pageTransition === 'soft') return;
            if (target.dataset.reveal === 'heading') {
              animateCharacters(target);
            } else {
              const siblings = [...(target.parentElement?.children || [])].filter((sibling) => sibling.matches('[data-reveal="item"]'));
              const delay = target.dataset.reveal === 'item' ? Math.min(siblings.indexOf(target) * configuration.itemStaggerMilliseconds, configuration.maximumStaggerMilliseconds) : 0;
              animate(target, [
                { opacity: 0, translate: `0 ${configuration.distancePixels}px` },
                { opacity: 1, translate: '0 0' },
              ], { duration: configuration.durationMilliseconds, delay, easing, fill: 'backwards' });
              // 内容内层沿用同一次观察，日期或封面先出现，文字稍后接入。
              if (target.matches('.article-card')) {
                target.dataset.revealed = 'true';
                const contentType = target.dataset.contentType;
                const details = target.querySelector<HTMLElement>(contentType === 'note' ? '[data-card-excerpt]' : '.article-card__copy');
                if (details && contentType !== 'update') animate(details, [
                  { opacity: 0, translate: `0 ${configuration.distancePixels / 3}px` },
                  { opacity: 1, translate: '0 0' },
                ], { duration: configuration.durationMilliseconds, delay: delay + configuration.itemStaggerMilliseconds, easing, fill: 'backwards' });
              }
            }
          });
        }, { rootMargin: `0px 0px -${configuration.bottomInsetPercent}% 0px`, threshold: configuration.visibilityThreshold });
        revealTargets.forEach((target) => {
          revealObserver.observe(target);
          target.classList.add('reveal-pending');
        });
        const stopReveals = () => {
          if (!revealIsDisabled()) return;
          revealObserver.disconnect();
          revealTargets.forEach((target) => target.classList.remove('reveal-pending'));
        };
        revealMotion.addEventListener('change', stopReveals);
        new MutationObserver(stopReveals).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }

    </script>
  </body>
</html>
