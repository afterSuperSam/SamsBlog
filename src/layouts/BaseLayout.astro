---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';
import '../styles/legacy-layout.css';
import AmbientScene from '../components/AmbientScene.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  quickNavigation?: { href: string; label: string; description?: string }[];
}

const {
  title,
  description = siteConfig.description,
  image = '/media/anime/hero/1719656915755.webp',
  bodyClass = '',
  quickNavigation = [],
} = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.name;
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl);

---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202123" data-theme-color />
    <link rel="icon" href="/media/brand/logo.jpg" type="image/jpeg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, siteConfig.siteUrl)} />
    <title>{pageTitle}</title>
    <script is:inline>
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      let initialTheme = systemDark ? 'dark' : 'light';
      try {
        const savedTheme = localStorage.getItem('samsblog-theme');
        if (savedTheme === 'dark' || savedTheme === 'light') initialTheme = savedTheme;
      } catch (error) { console.warn('Theme preference unavailable', error); }
      document.documentElement.dataset.theme = initialTheme;
      document.querySelector('meta[data-theme-color]')?.setAttribute('content', initialTheme === 'dark' ? '#202123' : '#f4fbfc');
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    {!bodyClass.includes('admin-page') && <div class="reading-progress" aria-hidden="true" data-reading-progress hidden></div>}
    {!bodyClass.includes('admin-page') && <AmbientScene />}
    <Header showMotion={!bodyClass.includes('admin-page')} />
    <main id="main-content" tabindex="-1">
      {quickNavigation.length > 0 && <nav class:list={['home-quick-nav', { visible: !bodyClass.includes('home-page') }]} aria-label={`${title || '首页'}快捷导航`} aria-hidden={bodyClass.includes('home-page')} inert={bodyClass.includes('home-page')} data-quick-nav data-reveal-after-hero={String(bodyClass.includes('home-page'))} data-activation-ratio={siteConfig.navigation.sectionActivationRatio}>
        {quickNavigation.map((item) => <a href={item.href} aria-label={item.description || item.label}><span>{item.label}</span><i></i></a>)}
      </nav>}
      <slot />
    </main>
    <Footer />
    {!bodyClass.includes('admin-page') && <div id="site-tooltip" class="site-tooltip" popover="manual" role="tooltip"></div>}
    <script>
      // 首页和关于页共用区块定位、光晕扩散与疏密交互。
      document.querySelectorAll<HTMLElement>('[data-quick-nav]').forEach((quickNav) => {
        const quickNavItems = [...(quickNav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') || [])].flatMap((link) => {
          const section = document.getElementById(link.hash.slice(1));
          return section ? [{ link, section }] : [];
        });
        let hoveredNavigation: number | null = null;
        let focusedNavigation: number | null = null;
        let quickNavFrame = 0;
        const updateQuickNav = () => {
          quickNavFrame = 0;
          const visible = quickNav.dataset.revealAfterHero !== 'true' || window.scrollY > Math.min(window.innerHeight * 0.55, 520);
          quickNav.classList.toggle('visible', visible);
          quickNav.setAttribute('aria-hidden', String(!visible));
          quickNav.toggleAttribute('inert', !visible);
          const activationLine = window.innerHeight * Number(quickNav.dataset.activationRatio);
          let currentIndex = 0;
          quickNavItems.forEach(({ section }, index) => {
            if (section.getBoundingClientRect().top <= activationLine) currentIndex = index;
          });
          if (window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1) currentIndex = quickNavItems.length - 1;
          const spacingIndex = hoveredNavigation ?? focusedNavigation ?? currentIndex;
          quickNavItems.forEach(({ link }, index) => {
            if (index === currentIndex) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
            const distance = index - spacingIndex;
            link.style.setProperty('--nav-distance', String(Math.abs(distance)));
            link.style.setProperty('--nav-direction', String(Math.sign(distance)));
            link.dataset.proximity = distance === 0 ? 'active' : Math.abs(distance) === 1 ? 'near' : 'far';
          });
        };
        const scheduleQuickNav = () => {
          if (quickNavFrame) return;
          quickNavFrame = window.requestAnimationFrame(updateQuickNav);
        };
        window.addEventListener('scroll', scheduleQuickNav, { passive: true });
        window.addEventListener('resize', scheduleQuickNav);
        quickNavItems.forEach(({ link }, index) => {
          link.addEventListener('pointerenter', () => { hoveredNavigation = index; scheduleQuickNav(); });
          link.addEventListener('pointerleave', () => { hoveredNavigation = null; scheduleQuickNav(); });
          link.addEventListener('focus', () => { focusedNavigation = index; scheduleQuickNav(); });
          link.addEventListener('blur', () => { focusedNavigation = null; scheduleQuickNav(); });
        });
        const mainContent = document.querySelector('main');
        if (mainContent) new ResizeObserver(scheduleQuickNav).observe(mainContent);
        updateQuickNav();
      });
      // 公开页的即时悬停与键盘提示，统一使用主题面板。
      const tooltip = document.querySelector<HTMLElement>('#site-tooltip');
      let tooltipTrigger: HTMLElement | null = null;
      const hideTooltip = () => {
        if (tooltipTrigger) {
          const descriptions = (tooltipTrigger.getAttribute('aria-describedby') || '').split(' ').filter((id) => id && id !== 'site-tooltip');
          if (descriptions.length) tooltipTrigger.setAttribute('aria-describedby', descriptions.join(' '));
          else tooltipTrigger.removeAttribute('aria-describedby');
          tooltipTrigger = null;
        }
        if (tooltip?.matches(':popover-open')) tooltip.hidePopover();
      };
      const showTooltip = (trigger: HTMLElement) => {
        if (!tooltip || !trigger.dataset.tooltip) return;
        if (tooltipTrigger !== trigger) hideTooltip();
        tooltipTrigger = trigger;
        tooltip.textContent = trigger.dataset.tooltip;
        const descriptions = new Set((trigger.getAttribute('aria-describedby') || '').split(' ').filter(Boolean));
        descriptions.add('site-tooltip');
        trigger.setAttribute('aria-describedby', [...descriptions].join(' '));
        if (!tooltip.matches(':popover-open')) tooltip.showPopover();
        const anchor = trigger.getBoundingClientRect();
        const detail = tooltip.getBoundingClientRect();
        const top = anchor.top >= detail.height + 20 ? anchor.top - detail.height - 10 : anchor.bottom + 10;
        tooltip.style.left = `${Math.max(12, Math.min(anchor.left + anchor.width / 2 - detail.width / 2, window.innerWidth - detail.width - 12))}px`;
        tooltip.style.top = `${Math.max(12, Math.min(top, window.innerHeight - detail.height - 12))}px`;
      };
      document.querySelectorAll<HTMLElement>('[data-tooltip]').forEach((trigger) => {
        trigger.addEventListener('pointerenter', () => showTooltip(trigger));
        trigger.addEventListener('focusin', () => showTooltip(trigger));
        trigger.addEventListener('click', () => showTooltip(trigger));
        trigger.addEventListener('pointerleave', () => { if (!trigger.contains(document.activeElement)) hideTooltip(); });
        trigger.addEventListener('focusout', (event) => { if (!(event.relatedTarget instanceof Node) || !trigger.contains(event.relatedTarget)) hideTooltip(); });
      });
      window.addEventListener('scroll', hideTooltip, { capture: true, passive: true });
      window.addEventListener('resize', hideTooltip);
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') hideTooltip(); });

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('samsblog-theme', next); }
        catch (error) { console.warn('Theme preference unavailable', error); }
        document.querySelector('meta[data-theme-color]')?.setAttribute('content', next === 'dark' ? '#202123' : '#f4fbfc');
      });

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      if (progress) {
        let progressFrame = 0;
        const updateProgress = () => {
          progressFrame = 0;
          const distance = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.setProperty('--reading-progress', String(distance > 0 ? window.scrollY / distance : 1));
        };
        const scheduleProgress = () => {
          if (!progressFrame) progressFrame = requestAnimationFrame(updateProgress);
        };
        progress.hidden = false;
        window.addEventListener('scroll', scheduleProgress, { passive: true });
        window.addEventListener('resize', scheduleProgress);
        updateProgress();
      }
      const revealTargets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (!reducedMotion && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).classList.remove('reveal-pending');
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -9% 0px', threshold: 0.08 });
        revealTargets.forEach((target) => {
          revealObserver.observe(target);
          target.classList.add('reveal-pending');
        });
      }

    </script>
  </body>
</html>
