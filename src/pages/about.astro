<BaseLayout title="关于" description="联系方式、网站友链、GitHub 贡献与模型用量痕迹。" bodyClass="about-page" quickNavigation={[
  { href: '#contact', label: '联系' },
  { href: '#activity', label: '痕迹' },
  { href: '#sponsor', label: '赞赏' },
  { href: '#friends', label: '友链' },
]}>
  <section class="about-contact" id="contact" data-reveal>
    <div class="shell">
      <header class="about-section-heading">
        <span>CONTACT</span>
        <h1>联系</h1>
      </header>
    </div>
    <nav class="shell about-links" aria-label="个人链接">
      <a class="about-link" href={siteConfig.social.bilibili} target="_blank" rel="noreferrer">
        <span class="about-link__icon"><SocialIcon name="bilibili" /></span>
        <span class="about-link__copy"><strong>Bilibili</strong><small>动态与视频</small></span>
      </a>
      <a class="about-link" href={siteConfig.social.github} target="_blank" rel="noreferrer">
        <span class="about-link__icon"><SocialIcon name="github" /></span>
        <span class="about-link__copy"><strong>GitHub</strong><small>afterSuperSam</small></span>
      </a>
      <button class="about-link" type="button" data-about-copy-qq data-qq={siteConfig.social.qq} aria-label={`复制 QQ 号 ${siteConfig.social.qq}`}>
        <span class="about-link__icon"><SocialIcon name="qq" /></span>
        <span class="about-link__copy"><strong>QQ</strong><small role="status" data-about-qq-label>{siteConfig.social.qq}</small></span>
      </button>
      <a class="about-link" href="https://moesam.com" target="_blank" rel="noreferrer">
        <span class="about-link__icon"><SocialIcon name="town" /></span>
        <span class="about-link__copy"><strong>楹雾镇</strong><small>moesam.com</small></span>
      </a>
    </nav>
  </section>

  <section class="about-activity" id="activity" data-reveal>
    <div class="shell">
      <header class="about-section-heading">
        <span>TRACES</span>
        <h2>痕迹</h2>
      </header>
      <div class="contribution-panels">
        <ContributionGraph title="GitHub 提交" eyebrow="CODE" calendar={githubContributions} href={siteConfig.social.github} inlineTotal latestContribution={latestContribution} />
        <ContributionGraph title="ChatGPT 用量" eyebrow="TOKENS" calendar={gptTokenUsage} unit="Token" period="CCswitch 记录 · 2026-10-24（当日未完）" showUsage inlineTotal />
        <ContributionGraph title="文章数量" eyebrow="ARTICLES" calendar={publicationCalendar} unit="篇" period="累计文章 · 近一年分布" inlineTotal />
      </div>
    </div>
  </section>

  <section class="about-sponsor" id="sponsor">
    <div class="shell sponsor-layout">
      {sponsors.length > 0 && <button type="button" class="sponsor-toggle" aria-label="展开赞助清单" aria-expanded="false" aria-controls="sponsor-list" data-sponsor-toggle></button>}
      <div class="sponsor-copy" data-reveal>
        <span>SUPPORT</span>
        <h2>赞赏支持</h2>
        <p>谢谢你在这里停留，愿你今天也有一点小小的快乐。</p>
        <p>你可以通过添加我的个人联系方式来支持我哦~</p>
        <p>建站不易，若有整改建议等，可留言或投稿邮箱 <a href="mailto:3092243018@qq.com">3092243018@qq.com</a></p>
      </div>
      <div class="sponsor-display" data-sponsor-display>
        <div class:list={['sponsor-list', { 'sponsor-list--columns': sponsors.length >= siteConfig.sponsorPresentation.twoColumnMinimumCount }]} id="sponsor-list" hidden>
          <h3>赞助我的小游戏服务器：</h3>
          <ol>{sponsors.map((sponsor) => {
            const avatarUrl = sponsorAvatarUrl(sponsor);
            return <li>
            <span class="sponsor-avatar" aria-hidden="true"><span>{Array.from(sponsor.name)[0]}</span>{avatarUrl && <img src={avatarUrl} width={siteConfig.sponsorPresentation.avatarSizePixels} height={siteConfig.sponsorPresentation.avatarSizePixels} loading="lazy" decoding="async" referrerpolicy="no-referrer" alt="" data-sponsor-avatar />}</span>
            <span>{sponsor.name}</span><strong>¥{sponsor.amount}</strong>
          </li>})}</ol>
        </div>
        <span class="sponsor-smile" aria-hidden="true" data-sponsor-smile>(｡･ω･｡)ﾉ♡</span>
      </div>
    </div>
  </section>
  <FriendsSection />
</BaseLayout>

<script>
  import { animateContentHeight, animateMotion } from '../lib/motion';
  import { siteConfig } from '../config/site';
  const sponsorToggle = document.querySelector<HTMLButtonElement>('[data-sponsor-toggle]');
  const sponsorDisplay = document.querySelector<HTMLElement>('[data-sponsor-display]');
  const sponsorList = document.querySelector<HTMLElement>('#sponsor-list');
  const sponsorSmile = document.querySelector<HTMLElement>('[data-sponsor-smile]');
  let avatarsReady: Promise<void> | undefined;
  const prepareAvatars = () => avatarsReady ??= Promise.all(
    [...document.querySelectorAll<HTMLImageElement>('[data-sponsor-avatar]')].map((image) => new Promise<void>((resolve) => {
      image.loading = 'eager';
      let settled = false;
      const finish = (loaded: boolean) => {
        if (settled) return;
        settled = true; window.clearTimeout(timeout); image.hidden = !loaded; resolve();
      };
      const timeout = window.setTimeout(() => finish(false), siteConfig.sponsorPresentation.avatarTimeoutMilliseconds);
      void image.decode().then(() => finish(true), () => finish(false));
    })),
  ).then(() => undefined);
  if (sponsorDisplay) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect(); void prepareAvatars();
    }, { rootMargin: `${siteConfig.sponsorPresentation.avatarPreloadMarginPixels}px` });
    observer.observe(sponsorDisplay);
  }
  let sponsorAnimation: Animation | undefined;
  sponsorToggle?.addEventListener('click', async () => {
    if (!sponsorDisplay || !sponsorList || !sponsorSmile || sponsorToggle.disabled) return;
    const open = sponsorToggle.getAttribute('aria-expanded') !== 'true';
    if (open) {
      sponsorToggle.disabled = true;
      sponsorToggle.setAttribute('aria-busy', 'true');
      sponsorToggle.setAttribute('aria-label', '正在准备赞助清单');
      await prepareAvatars();
      sponsorToggle.disabled = false;
      sponsorToggle.removeAttribute('aria-busy');
    }
    sponsorToggle.setAttribute('aria-expanded', String(open));
    sponsorToggle.setAttribute('aria-label', open ? '收起赞助清单' : '展开赞助清单');
    animateContentHeight(sponsorDisplay, () => { sponsorList.hidden = !open; sponsorSmile.hidden = open; });
    const target = open ? sponsorList : sponsorSmile;
    sponsorAnimation?.cancel();
    sponsorAnimation = animateMotion(target, [{ opacity: 0, translate: 'calc(-1 * var(--sponsor-reveal-distance)) 0' }, { opacity: 1, translate: '0 0' }], {
      duration: siteConfig.reveal.durationMilliseconds, easing: getComputedStyle(document.documentElement).getPropertyValue('--ease-out').trim(),
    });
  });
  const dateFormatter = new Intl.DateTimeFormat(navigator.language, { year: 'numeric', month: 'short', day: 'numeric' });
  document.querySelectorAll<HTMLTimeElement>('[data-local-date]').forEach((date) => {
    date.textContent = dateFormatter.format(new Date(`${date.dateTime}T12:00:00`));
  });
  const copyButton = document.querySelector<HTMLButtonElement>('[data-about-copy-qq]');
  const copyLabel = copyButton?.querySelector<HTMLElement>('[data-about-qq-label]');
  copyButton?.addEventListener('click', async () => {
    const qq = copyButton.dataset.qq;
    if (!qq) return;
    try {
      await navigator.clipboard.writeText(qq);
      copyButton.setAttribute('aria-label', `QQ 号 ${qq} 已复制`);
      if (copyLabel) copyLabel.textContent = '已复制';
    } catch (error) {
      copyButton.setAttribute('aria-label', '复制失败，请手动选择 QQ 号');
      if (copyLabel) copyLabel.textContent = `复制失败：${qq}`;
      console.warn('QQ clipboard copy failed', error);
    }
    window.setTimeout(() => {
      copyButton.setAttribute('aria-label', `复制 QQ 号 ${qq}`);
      if (copyLabel) copyLabel.textContent = qq;
    }, 1600);
  });

</script>
