---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../404.astro';
import { getArticle, getAdjacentArticles } from '../../lib/articles';
import { articleExcerpt, renderArticleMarkdown } from '../../lib/markdown';
import { siteConfig } from '../../config/site';
import '../../styles/articles.css';
import '../../styles/article-reading.css';
import ArticleDiscussion from '../../components/ArticleDiscussion.astro';

const identifier = Number(Astro.params.id);
const article = Number.isSafeInteger(identifier) && identifier > 0 ? getArticle(identifier) : undefined;
if (!article) Astro.response.status = 404;
const rendered = article ? renderArticleMarkdown(article.content) : { html: '', headings: [] };
const chapterLevel = rendered.headings.length ? Math.min(...rendered.headings.map((heading) => heading.level)) : 1;
const { previous, next } = article ? getAdjacentArticles(article) : { previous: undefined, next: undefined };
const author = article?.source === 'repost' ? article.originalAuthor : siteConfig.name;
const articleMetadata = article ? {
  publishedTime: article.createdAt, modifiedTime: article.updatedAt, author: author || '',
  structuredData: {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.title,
    description: article.summary || articleExcerpt(article.content), datePublished: article.createdAt, dateModified: article.updatedAt,
    ...(article.tags.length ? { keywords: article.tags.join(', ') } : {}),
    mainEntityOfPage: new URL(`/articles/${article.id}`, siteConfig.siteUrl).href,
    ...(article.coverUrl ? { image: new URL(article.coverUrl, siteConfig.siteUrl).href } : {}),
    ...(author ? { author: { '@type': article.source === 'repost' ? 'Person' : 'Organization', name: author } } : {}),
    publisher: { '@type': 'Organization', name: siteConfig.name },
    ...(article.originalUrl ? { isBasedOn: article.originalUrl } : {}),
  },
} : undefined;
const dateLabel = (value: string) => new Date(value).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
---

{article ? <BaseLayout title={article.title} description={article.summary || articleExcerpt(article.content)} image={article.coverUrl || undefined} articleMetadata={articleMetadata} bodyClass="article-page">
  <article class="article-reading shell" data-article-reading data-article-id={article.id} data-article-version={article.updatedAt}>
    <div class="article-reading__lead">
    <a class="articles-more article-reading__back" href="/content"><span aria-hidden="true">←</span> 回到内容</a>
    <header class="article-reading__heading">
      <div class="article-tags"><span>{article.source === 'original' ? '原创' : '搬运'}</span><span>{article.category === 'discussion' ? '杂谈' : '日志'}</span></div>
      <h1 id="article-start" class:list={{ 'article-title--starred': article.starred }}>{article.title}</h1>
      {article.tags.length > 0 && <nav class="article-keywords" aria-label="文章标签">{article.tags.map((tag) => <a href={`/content?${new URLSearchParams({ tag })}`}># {tag}</a>)}</nav>}
      <div class="article-reading__dates"><span>写于 <time datetime={article.createdAt}>{dateLabel(article.createdAt)}</time></span><span>编辑于 <time datetime={article.updatedAt}>{dateLabel(article.updatedAt)}</time></span></div>
      {article.source === 'repost' && (article.originalAuthor || article.originalUrl) && <p class="article-reading__source">{article.originalAuthor && <span>原作者：{article.originalAuthor}</span>}{article.originalUrl && <a href={article.originalUrl} target="_blank" rel="noopener noreferrer">阅读原文 ↗</a>}</p>}
      {article.contentType === 'link' && <p class="article-reading__source"><a href={article.externalUrl} target="_blank" rel="noopener noreferrer">打开推荐链接 ↗</a></p>}
    </header>
    {article.coverUrl && <img class="article-reading__cover" src={article.coverUrl} alt="文章首图" referrerpolicy="no-referrer" fetchpriority="high" />}
    <div class="article-reading__tools" data-reading-tools hidden>
      <button type="button" data-reading-mode data-tooltip="收窄正文宽度，减淡背景干扰" aria-pressed="false">舒适阅读</button>
      <button type="button" data-reading-font data-tooltip="在系统默认字体与本站艺术字体之间切换" aria-pressed="false">使用默认字体</button>
      <button type="button" data-reading-resume data-tooltip="回到这台设备上次读到的位置" hidden>继续阅读</button>
      <div class="article-typography" role="group" aria-label="正文字号与行距">
        <button type="button" data-reading-size="decrease" aria-label="缩小正文字号">A−</button>
        <output data-reading-size-label aria-live="polite">{siteConfig.articleReading.fontSizeDefault}px</output>
        <button type="button" data-reading-size="increase" aria-label="增大正文字号">A＋</button>
        <span class="article-typography__spacing" role="group" aria-label="正文行距"><button type="button" data-reading-spacing="standard" aria-pressed="true">标准</button><button type="button" data-reading-spacing="relaxed" aria-pressed="false">宽松</button></span>
      </div>
      <span class="article-reading__status" role="status" data-reading-status></span>
    </div>
    </div>
    {rendered.headings.length > 0 && <details class="article-toc">
      <summary>本文目录 <span>{rendered.headings.length} 节</span></summary>
      <nav aria-label="文章目录"><ol>{rendered.headings.map((heading) => <li data-level={heading.level} data-depth={Math.min(2, heading.level - chapterLevel)}><a href={`#${heading.id}`}>{heading.text}</a></li>)}</ol></nav>
    </details>}
    <div class="article-reading__content">
    <div class="article-prose" data-article-prose set:html={rendered.html}></div>
    {(previous || next) && <nav class="article-reading__footer" aria-label="相邻文章">
      {previous ? <a href={`/articles/${previous.id}`} rel="prev"><span>上一篇</span><strong>{previous.title}</strong></a> : <span />}
      {next && <a href={`/articles/${next.id}`} rel="next"><span>下一篇</span><strong>{next.title}</strong></a>}
    </nav>}
    <ArticleDiscussion articleId={article.id} />
    </div>
  </article>
  <dialog class="article-image-dialog" data-article-image-dialog aria-label="正文图片查看器">
    <div class="article-image-dialog__toolbar"><button type="button" data-image-zoom aria-pressed="false">放大图片</button><button type="button" data-image-close autofocus aria-label="关闭图片查看器">关闭 ×</button></div>
    <div class="article-image-dialog__state"><span data-image-status role="status" aria-live="polite"></span><button type="button" data-image-retry hidden>重新加载</button></div>
    <div class="article-image-dialog__viewport" data-image-viewport tabindex="0"><img data-image-full alt="" /></div>
    <p data-image-caption></p>
  </dialog>
  <dialog class="quote-dialog" data-quote-dialog aria-labelledby="quote-dialog-title">
    <header><h2 id="quote-dialog-title">留下一段文字</h2><button type="button" data-quote-close autofocus aria-label="关闭摘录卡片">关闭 ×</button></header>
    <canvas data-quote-canvas role="img" aria-label="摘录卡片预览"></canvas>
    <footer><a data-quote-download class="articles-more" download="SamsBlog-摘录.png">保存图片 ↘</a><span data-quote-status role="status"></span></footer>
  </dialog>
</BaseLayout> : <NotFound />}

<script>
  import '../../lib/article-reading';
</script>
