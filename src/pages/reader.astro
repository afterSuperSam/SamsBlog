---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readReaderSession } from '../lib/readers';
import '../styles/reader.css';
const reader = readReaderSession(Astro.cookies);
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<BaseLayout title="我的账号" description="管理读者资料、Passkey 和自己的留言。" bodyClass="reader-page">
  <section class="shell reader-account-page" data-reader-account-page data-reader-id={reader?.id || ''} aria-labelledby="reader-account-title">
    <header class="reader-account-intro"><span class="section-kicker">ACCOUNT</span><h1 id="reader-account-title">我的账号</h1><p>安放你的名字，也收好写过的纸条。</p></header>
    <section class="reader-paper" data-account-signed-out hidden={Boolean(reader)}><h2>先和我们打个招呼</h2><p>登录后可以修改资料、管理 Passkey 和查看自己的留言。</p><button type="button" data-account-login>打开登录面板 <span aria-hidden="true">↗</span></button></section>
    <div data-account-content hidden={!reader}>
      <section class="reader-paper reader-account-summary" aria-label="读者资料">
        <div class="reader-avatar" aria-hidden="true"><span data-account-initial>{Array.from(reader?.displayName || '读')[0]}</span><img data-account-avatar src={reader?.avatarUrl || undefined} hidden={!reader?.avatarUrl} alt="" width="72" height="72" referrerpolicy="no-referrer" /></div>
        <div><h2 data-account-name>{reader?.displayName}</h2><p data-account-method></p></div>
        <dl><div><dt>注册时间</dt><dd><time data-account-created>—</time></dd></div><div><dt>累计留言与评论</dt><dd data-account-comment-count>—</dd></div></dl>
      </section>
      <div class="reader-account-grid">
        <section class="reader-paper reader-account-wide" aria-labelledby="reader-profile-title"><h2 id="reader-profile-title">我的资料</h2><p class="reader-help">昵称用于留言和评论，保存后以前的署名也会更新。</p>
          <form method="post" action="/api/reader/account.json" data-account-profile novalidate>
            <label class="reader-field">昵称<input name="displayName" value={reader?.displayName || ''} minlength="2" maxlength="48" autocomplete="nickname" required disabled /></label>
            <label class="reader-field">个人网站 · 可选<input name="websiteUrl" type="url" maxlength="2048" placeholder="https://example.com" autocomplete="url" disabled /></label>
            <footer><button type="submit" disabled>保存资料 <span aria-hidden="true">↗</span></button><a data-account-website hidden target="_blank" rel="noopener noreferrer">打开我的网站 ↗</a></footer>
            <p class="reader-feedback" data-profile-feedback role="status" aria-live="polite"></p>
          </form>
        </section>
        <section class="reader-paper reader-account-wide" aria-labelledby="reader-passkeys-title"><h2 id="reader-passkeys-title">我的 Passkey</h2><p class="reader-help">使用设备上的指纹、面容或屏幕锁登录。添加和移除前需要近期验证身份。</p>
          <ul class="reader-passkeys" data-account-passkeys></ul><p class="reader-help" data-passkeys-empty>正在读取…</p>
          <form class="reader-passkey-add" method="post" data-passkey-add novalidate><label class="reader-field">给设备起个名字<input name="label" maxlength="120" placeholder="例如：我的笔记本" required disabled /></label><button type="submit" disabled>添加 Passkey <span aria-hidden="true">＋</span></button></form>
          <p class="reader-feedback" data-passkey-feedback role="status" aria-live="polite"></p>
        </section>
        <section class="reader-paper reader-account-wide" aria-labelledby="reader-comments-title"><h2 id="reader-comments-title" tabindex="-1">我的留言与评论</h2><p class="reader-help">仅你自己可以在这里查看尚未公开的内容。</p>
          <ol class="reader-comments" data-account-comments></ol><p class="reader-help" data-comments-empty>正在读取…</p>
          <nav class="reader-pagination" aria-label="我的留言分页"><button type="button" data-comments-previous disabled>上一页</button><span data-comments-page>—</span><button type="button" data-comments-next disabled>下一页</button></nav>
          <p class="reader-feedback" data-comments-feedback role="status" aria-live="polite"></p>
        </section>
      </div>
    </div>
    <p class="reader-feedback" data-account-feedback role="status" aria-live="polite">{Astro.url.searchParams.get('error') === 'oauth' ? '这次登录未能完成，请重新打开登录面板。' : ''}</p>
    <noscript><p>账号管理需要启用 JavaScript，文章仍可正常阅读。</p></noscript>
  </section>
</BaseLayout>
<script>
  import { initializeReaderAccount } from '../lib/reader-account-client';
  initializeReaderAccount();
</script>
