---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminArticles from '../components/AdminArticles.astro';
import { readAdminSession } from '../lib/admin-auth';
import { listAllMessages, type MessageStatus } from '../lib/db';
import { listFriends } from '../lib/friends';
import AdminProjects from '../components/AdminProjects.astro';
import AdminMedia from '../components/AdminMedia.astro';
import AdminSponsors from '../components/AdminSponsors.astro';
import AdminDrawer from '../components/AdminDrawer.astro';
import AdminStatistics from '../components/AdminStatistics.astro';
import AdminApplications from '../components/AdminApplications.astro';
import { adminNotificationsConfigured, listReplyNotifications, replyNotificationsConfigured } from '../lib/reply-notifications';
import '../styles/guestbook.css';
import '../styles/admin.css';
import '../styles/admin-friends.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const authenticated = readAdminSession(Astro.cookies);
const activeSection = Astro.params.section || 'overview';
const sections = [{ id: 'overview', label: '概览' }, { id: 'articles', label: '内容' }, { id: 'media', label: '媒体' },
  { id: 'messages', label: '评论与留言' }, { id: 'friends', label: '友链' }, { id: 'applications', label: '友链申请' },
  { id: 'projects', label: '项目' }, { id: 'sponsors', label: '赞助' }, { id: 'analytics', label: '访问统计' }, { id: 'notifications', label: '邮件通知' }];
const messages = authenticated && activeSection === 'messages' ? listAllMessages() : [];
const friends = authenticated && activeSection === 'friends' ? listFriends({ includeHidden: true }) : [];
const repliesByParent = new Map<number, typeof messages>();
for (const message of messages) {
  if (message.parentId === null) continue;
  const replies = repliesByParent.get(message.parentId) || [];
  replies.push(message);
  repliesByParent.set(message.parentId, replies);
}
const rootMessages = messages
  .filter((message) => message.parentId === null)
  .map((message) => ({ ...message, replies: repliesByParent.get(message.id) || [] }));
const statuses = ['pending', 'published', 'hidden'] as const;
const statusLabels: Record<MessageStatus, string> = {
  pending: '待审核',
  published: '已公开',
  hidden: '已隐藏',
};
const statusCounts = Object.fromEntries(statuses.map((status) => [status, messages.filter((message) => message.status === status).length]));
const dateFormatter = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
---

<BaseLayout title="内容后台" description="SamsBlog 文章、友链与留言管理。" bodyClass="admin-page" quickNavigation={[]}>
  <section class="admin-shell shell">
    <noscript><p>管理表单需要启用 JavaScript 后才能提交。</p></noscript>
    {authenticated ? (
      <>
        <dialog class="admin-confirm" data-admin-confirm aria-labelledby="admin-confirm-title" aria-describedby="admin-confirm-message">
          <span class="admin-confirm__mark" aria-hidden="true">✧</span>
          <h2 id="admin-confirm-title">再确认一下</h2>
          <p id="admin-confirm-message" data-admin-confirm-message></p>
          <div class="admin-confirm__actions"><button type="button" data-admin-confirm-cancel autofocus>取消</button><button type="button" data-admin-confirm-accept>确定</button></div>
        </dialog>
        <header class="admin-header">
          <div class="admin-header__copy"><span>ADMIN</span><h1>内容后台</h1></div>
          <div class="admin-header__tools">
            {activeSection === 'messages' && <div class="admin-summary" aria-label="留言状态统计">
              {statuses.map((status) => <span data-status={status}><b>{statusCounts[status]}</b>{statusLabels[status]}</span>)}
            </div>}
            <button class="admin-logout" type="button" data-admin-logout>
              <span>退出</span>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 5H5v14h5M14 8l4 4-4 4M9 12h9" /></svg>
            </button>
          </div>
        </header>
        <p class="form-status" role="status" data-admin-feedback></p>
        <div class="admin-workspace">
        <nav class="admin-navigation" aria-label="后台分区">{sections.map((section) => <a href={section.id === 'overview' ? '/admin' : `/admin/${section.id}`} aria-current={activeSection === section.id ? 'page' : undefined}>{section.label}</a>)}</nav>
        <div class="admin-workspace__main">
        {activeSection === 'overview' && <section class="admin-panel"><header class="admin-panel__heading"><div><span>OVERVIEW</span><h2>工作台</h2></div><p>选择分区管理，编辑操作在右侧抽屉完成。</p></header><div class="admin-overview-grid">{sections.filter((section) => section.id !== 'overview').map((section) => <a href={`/admin/${section.id}`}><span>{section.label}</span><span aria-hidden="true">↗</span></a>)}</div></section>}
        {activeSection === 'articles' && <AdminArticles />}
        {activeSection === 'media' && <AdminMedia />}
        {activeSection === 'analytics' && <AdminStatistics />}
        {activeSection === 'applications' && <AdminApplications />}
        {activeSection === 'notifications' && <section class="admin-panel"><header class="admin-panel__heading"><div><span>NOTIFICATIONS</span><h2>邮件通知</h2></div></header><p>{replyNotificationsConfigured ? 'Resend 发信配置已填写。“已提交”表示服务商已接受请求，实际收件仍需邮箱验证。' : '尚未启用。验证发信域名后，设置 RESEND_API_KEY、MAIL_FROM 和 BLOG_SECRET，再重启博客。访客端暂不展示邮件通知选项。'}</p><p>{adminNotificationsConfigured ? '站长提醒已开启：接收新留言、访客回复和友链申请；后台回复不通知自己。' : '站长提醒未开启：设置 MAIL_ADMIN_TO 后重启博客。'}</p><a href="https://resend.com/templates" target="_blank" rel="noopener noreferrer">管理 Resend 邮件模板 ↗</a><div class="admin-data-table"><table><thead><tr><th>来源</th><th>通知类型</th><th>状态</th><th>尝试次数</th></tr></thead><tbody>{listReplyNotifications().map((notification) => <tr><td>{notification.nickname}</td><td>{{ reply: '访客回信', message: '站长 · 留言', application: '站长 · 友链' }[notification.kind]}</td><td>{{ pending: '等待发送', sent: '已提交', failed: '发送失败', cancelled: '已取消' }[notification.status]}</td><td>{notification.attempts}</td></tr>)}</tbody></table></div></section>}

        {activeSection === 'messages' && <section class="admin-panel" id="messages">
          <header class="admin-panel__heading"><div><span>01 / VOICES</span><h2>留言</h2></div><p>审核、回复或收起访客留下的纸条。</p></header>
          <div class="admin-message-list">
          {rootMessages.length === 0 ? <p class="admin-empty">还没有留言。</p> : rootMessages.map((message, index) => (
            <article class="admin-message-card" data-admin-message data-id={message.id} data-status={message.status}>
              <span class="admin-message-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="admin-message-card__body"><div class="admin-message-summary"><b>{message.nickname}</b>{message.articleId && <a href={`/articles/${message.articleId}`}>文章 #{message.articleId}</a>}<p>{message.content}</p><button type="button" data-drawer-open={`message-${message.id}`}>查看与回复</button></div>
                <AdminDrawer id={`message-${message.id}`} title={`回复 ${message.nickname}`}>
                <header>
                  <span class="admin-message-card__avatar" aria-hidden="true">{message.nickname.slice(0, 1)}</span>
                  <div><b>{message.nickname}</b><time>{dateFormatter.format(new Date(message.createdAt))}</time></div>
                  <span class="admin-message-card__status" data-admin-status-label>{statusLabels[message.status]}</span>
                </header>
                <div class="admin-message-card__note"><p>{message.content}</p></div>
                {message.replies && message.replies.length > 0 && (
                  <div class="admin-message-card__replies">
                    {message.replies.map((reply) => <div class="admin-message-reply" data-admin-message data-id={reply.id} data-parent-id={message.id} data-status={reply.status}>
                      <p><b>{reply.nickname}</b><span>{reply.content}</span></p>
                      <span class="admin-message-card__status" data-admin-status-label>{statusLabels[reply.status]}</span>
                      <div class="admin-actions" aria-label={`${reply.nickname}的回复操作`}>
                        {statuses.map((status) => <button type="button" data-status={status} aria-pressed={reply.status === status}>{statusLabels[status]}</button>)}
                        <button class="admin-delete" type="button" data-delete>删除回复</button>
                      </div>
                      <div class="form-status" role="status" data-admin-feedback></div>
                    </div>)}
                  </div>
                )}
                <footer>
                  <div class="admin-actions" aria-label="修改留言状态">
                    {statuses.map((status) => (
                      <button type="button" data-status={status} aria-pressed={message.status === status}>{statusLabels[status]}</button>
                    ))}
                  </div>
                  <button class="admin-delete" type="button" data-delete>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 7h14M9 7V4h6v3M8 10v7M12 10v7M16 10v7M7 7l1 13h8l1-13" /></svg>
                    <span>删除</span>
                  </button>
                </footer>
                <form method="post" novalidate class="admin-reply" data-reply-form>
                  <input name="content" minlength="2" maxlength="1000" aria-label={`回复 ${message.nickname} 的留言`} placeholder="以 Sam 的身份回一张纸条…" required />
                  <button type="submit" disabled>
                    <span>回复</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m8 5 7 7-7 7" /></svg>
                  </button>
                </form>
                <p class="form-status" role="status" data-admin-feedback></p>
                </AdminDrawer>
              </div>
            </article>
          ))}
          </div>
        </section>}

        {activeSection === 'friends' && <section class="admin-panel" id="friends">
          <header class="admin-panel__heading"><div><span>FRIENDS</span><h2>友链管理</h2></div><button type="button" data-drawer-open="friend-create">＋ 添加友链</button></header>
          <AdminDrawer id="friend-create" title="添加友链">
          <form method="post" novalidate class="admin-friend-import" data-friend-import>
            <label><span>名称</span><input name="name" minlength="1" maxlength="60" placeholder="站点名称" required /></label>
            <label><span>地址</span><textarea name="url" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="https://example.com" required></textarea></label>
            <label><span>简介</span><textarea name="description" rows="2" minlength="1" maxlength="240" placeholder="一句话介绍这个站点" required></textarea></label>
            <label><span>图标网址</span><textarea name="iconUrl" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="https://example.com/favicon.ico" required></textarea></label>
            <label><span>背景图片网址 · 可选</span><textarea name="backgroundUrl" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="留空时使用头像虚化背景"></textarea></label>
            <label><span>RSS 地址 · 可选</span><textarea name="rssUrl" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="https://example.com/rss.xml"></textarea></label>
            <button class="media-button" type="submit" disabled>＋ 导入友链</button>
            <small class="form-status" role="status" aria-live="polite" data-admin-feedback>图标和背景仅保存网址；背景留空时使用头像虚化效果。</small>
          </form>
          </AdminDrawer>
          <div class="admin-friend-list">
            {friends.map((friend) => (
              <div class="admin-record-row"><div><b>{friend.name}</b><p>{friend.description}</p></div><button type="button" data-drawer-open={`friend-${friend.id}`}>编辑</button>
              <AdminDrawer id={`friend-${friend.id}`} title={`编辑 ${friend.name}`}>
              <form method="post" novalidate class="admin-friend-card" data-friend-id={friend.id}>
                <span class="admin-friend-card__icon"><b>{friend.name.slice(0, 1)}</b><img src={friend.iconUrl} alt="" loading="lazy" referrerpolicy="no-referrer" /></span>
                <div class="admin-friend-card__fields">
                  <label><span>名称</span><input name="name" value={friend.name} minlength="1" maxlength="60" aria-label="友链名称" required /></label>
                  <label><span>地址</span><textarea name="url" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" aria-label="友链地址" required>{friend.url}</textarea></label>
                  <label><span>简介</span><textarea name="description" rows="2" minlength="1" maxlength="240" aria-label="友链简介" required>{friend.description}</textarea></label>
                  <label><span>图标网址</span><textarea name="iconUrl" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" aria-label="友链图标网址" required>{friend.iconUrl}</textarea></label>
                  <label><span>背景图片网址 · 可选</span><textarea name="backgroundUrl" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" aria-label="友链背景图片网址" placeholder="留空时使用头像虚化背景">{friend.backgroundUrl}</textarea></label>
                  <label><span>RSS 地址 · 可选</span><textarea name="rssUrl" rows="2" inputmode="url" autocapitalize="off" spellcheck="false" aria-label="友链 RSS 地址" placeholder="留空时不显示 RSS 入口">{friend.rssUrl}</textarea></label>
                </div>
                <label class="admin-friend-card__visible"><input name="visible" type="checkbox" checked={friend.visible} />公开</label>
                <footer><button type="submit" disabled>保存</button><button type="button" data-delete-friend>删除</button></footer>
                <p class="form-status" role="status" data-admin-feedback></p>
              </form>
              </AdminDrawer></div>
            ))}
          </div>
        </section>}

        {activeSection === 'projects' && <AdminProjects />}
        {activeSection === 'sponsors' && <AdminSponsors />}
        </div></div>
      </>
    ) : (
      <div class="admin-login-scene">
        <div class="admin-login__decor" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>
        <form method="post" novalidate class="admin-login" data-admin-login>
          <div class="admin-login__brand">
            <img src="/media/brand/logo.jpg" alt="" width="40" height="40" />
            <span>SamsBlog</span>
          </div>
          <div class="admin-login__heading">
            <h1>内容后台</h1>
            <p>管理员密码只在服务器环境变量中配置。</p>
          </div>
          <label class="admin-login__field">
            <span>管理员密码</span>
            <span class="admin-login__input">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7.5 10V7.7a4.5 4.5 0 0 1 9 0V10M6 10h12v9H6z" /></svg>
              <input name="password" type="password" autocomplete="current-password" placeholder="输入密码" required />
            </span>
          </label>
          <div class="admin-login__actions">
            <button class="button button--primary admin-login__submit" type="submit" disabled>
              <span>进入管理</span>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m8 5 7 7-7 7" /></svg>
            </button>
            <small role="status" aria-live="polite" data-admin-feedback></small>
          </div>
        </form>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  import { beginAdminAction, bindAdminNavigation, confirmAdminAction, prepareAdminNavigation } from '../lib/admin-dialog';
  import { requestJson } from '../lib/client-request';
  import { animateContentHeight } from '../lib/motion';
  bindAdminNavigation();
  // 后台写入统一呈现失败，并防止同一区域重复提交。
  async function sendAdminRequest(url: string, method: string, payload?: unknown) {
    return requestJson<{ error?: string; message?: string; id?: number }>(url, method, payload, '管理服务暂时不可用，请稍后重试。');
  }

  async function runAdminAction(container: HTMLElement, action: () => Promise<string | void>, reloadOnSuccess = false) {
    if (container.closest('[aria-busy="true"]') || container.querySelector('[aria-busy="true"]')) return;
    const release = reloadOnSuccess ? await prepareAdminNavigation() : beginAdminAction(container);
    if (!release) return;
    const owner = container.closest('[data-admin-message]');
    const status = [...container.querySelectorAll<HTMLElement>('[data-admin-feedback]')].find((field) => field.closest('[data-admin-message]') === owner)
      || document.querySelector<HTMLElement>('[data-admin-feedback]');
    const controls = [...container.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | HTMLButtonElement>('input,textarea,select,button')];
    const disabledStates = controls.map((control) => control.disabled);
    let reloading = false;
    container.setAttribute('aria-busy', 'true');
    controls.forEach((control) => { control.disabled = true; });
    const feedback = (message: string, state: string) => { if (status) animateContentHeight(status, () => { status.textContent = message; status.dataset.state = state; }); };
    feedback('正在处理…', 'loading');
    try {
      const message = await action();
      feedback(message || '操作成功。', 'success');
      reloading = reloadOnSuccess;
      if (reloading) window.location.reload();
    } catch (error) {
      reloading = false;
      feedback(error instanceof TypeError ? '网络连接失败，请检查连接后重试。' : error instanceof Error ? error.message : '操作失败，请稍后重试。', 'error');
      console.warn('Admin action failed', error);
    } finally {
      if (!reloading) {
        container.removeAttribute('aria-busy');
        controls.forEach((control, index) => { control.disabled = disabledStates[index]; });
        release();
      }
    }
  }

  const login = document.querySelector<HTMLFormElement>('[data-admin-login]');
  login?.addEventListener('submit', (event) => {
    event.preventDefault();
    const payload = { password: new FormData(login).get('password') };
    void runAdminAction(login, async () => {
      await sendAdminRequest('/api/admin/login.json', 'POST', payload);
      return '登录成功。';
    }, true);
  });
  login?.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');

  document.querySelector<HTMLElement>('[data-admin-logout]')?.addEventListener('click', () => {
    const shell = document.querySelector<HTMLElement>('.admin-shell');
    if (!shell) return;
    void runAdminAction(shell, async () => {
      await sendAdminRequest('/api/admin/logout.json', 'POST');
      return '已退出。';
    }, true);
  });

  const messageLabels: Record<string, string> = { pending: '待审核', published: '已公开', hidden: '已隐藏' };
  const refreshMessageCounts = () => {
    const messages = [...document.querySelectorAll<HTMLElement>('[data-admin-message]')];
    Object.keys(messageLabels).forEach((status) => {
      const count = document.querySelector<HTMLElement>(`.admin-summary [data-status="${status}"] b`);
      if (count) count.textContent = String(messages.filter((message) => message.dataset.status === status).length);
    });
  };
  const bindMessageActions = (message: HTMLElement) => {
    const owned = <T extends HTMLElement>(selector: string) => [...message.querySelectorAll<T>(selector)].filter((element) => element.closest('[data-admin-message]') === message);
    const id = Number(message.dataset.id);
    owned<HTMLButtonElement>('[data-status]').forEach((button) => button.addEventListener('click', () => {
      void runAdminAction(message, async () => {
        await sendAdminRequest('/api/admin/messages.json', 'PATCH', { id, status: button.dataset.status });
        const nextStatus = button.dataset.status || '';
        message.dataset.status = nextStatus;
        const label = owned<HTMLElement>('[data-admin-status-label]')[0];
        if (label) label.textContent = messageLabels[nextStatus] || nextStatus;
        owned<HTMLButtonElement>('[data-status]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        refreshMessageCounts();
        return '留言状态已更新。';
      });
    }));
    owned<HTMLButtonElement>('[data-delete]')[0]?.addEventListener('click', async () => {
      const reply = message.hasAttribute('data-parent-id');
      if (!await confirmAdminAction(reply ? '确定删除这条回复吗？' : '确定删除这条留言吗？回复也会一起删除。', reply ? '删除回复' : '删除留言')) return;
      void runAdminAction(message, async () => {
        await sendAdminRequest('/api/admin/messages.json', 'DELETE', { id });
        if (!reply) message.querySelector<HTMLDialogElement>('dialog')?.close();
        message.remove();
        refreshMessageCounts();
      });
    });
    const replyForm = owned<HTMLFormElement>('[data-reply-form]')[0];
    const replyInput = replyForm?.querySelector<HTMLInputElement>('input[name="content"]');
    replyInput?.addEventListener('input', () => replyInput.removeAttribute('aria-invalid'));
    replyForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const replyForm = event.currentTarget as HTMLFormElement;
      const content = String(new FormData(replyForm).get('content') || '').trim();
      const characterCount = Array.from(content).length;
      if (characterCount < 2 || characterCount > 500 || content.includes('\u0000')) {
        const feedback = owned<HTMLElement>('[data-admin-feedback]')[0];
        if (feedback) animateContentHeight(feedback, () => {
          feedback.textContent = content.includes('\u0000') ? '回复不能包含空字符。' : '回复需要 2–500 个字符。';
          feedback.dataset.state = 'error';
        });
        replyInput?.setAttribute('aria-invalid', 'true');
        replyInput?.focus();
        return;
      }
      void runAdminAction(message, async () => {
        const result = await sendAdminRequest('/api/admin/messages.json', 'POST', { parentId: id, content });
        if (!Number.isSafeInteger(result.id) || Number(result.id) <= 0) throw new Error('回复已送出，请刷新页面查看结果。');
        let replies = message.querySelector<HTMLElement>('.admin-message-card__replies');
        if (!replies) {
          replies = document.createElement('div');
          replies.className = 'admin-message-card__replies';
          message.querySelector('.admin-message-card__note')?.after(replies);
        }
        const reply = document.createElement('div');
        reply.className = 'admin-message-reply';
        reply.dataset.adminMessage = '';
        reply.dataset.id = String(result.id);
        reply.dataset.parentId = String(id);
        reply.dataset.status = 'published';
        reply.innerHTML = '<p><b>Sam</b><span data-reply-content></span></p><span class="admin-message-card__status" data-admin-status-label>已公开</span><div class="admin-actions" aria-label="Sam的回复操作"></div><div class="form-status" role="status" data-admin-feedback></div>';
        reply.querySelector<HTMLElement>('[data-reply-content]')!.textContent = content;
        const actions = reply.querySelector<HTMLElement>('.admin-actions')!;
        Object.entries(messageLabels).forEach(([status, label]) => {
          const button = document.createElement('button');
          button.type = 'button'; button.dataset.status = status; button.textContent = label;
          button.setAttribute('aria-pressed', String(status === 'published'));
          actions.append(button);
        });
        const remove = document.createElement('button');
        remove.type = 'button'; remove.className = 'admin-delete'; remove.dataset.delete = ''; remove.textContent = '删除回复';
        actions.append(remove);
        replies.append(reply);
        bindMessageActions(reply);
        replyForm.reset();
        refreshMessageCounts();
        return '回复已公开。';
      });
    });
    replyForm?.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');
  };
  document.querySelectorAll<HTMLElement>('[data-admin-message]').forEach(bindMessageActions);

  const friendPayload = (form: HTMLFormElement, id?: number) => {
    const data = new FormData(form);
    return {
      id,
      name: data.get('name'),
      url: data.get('url'),
      description: data.get('description'),
      iconUrl: data.get('iconUrl'),
      backgroundUrl: data.get('backgroundUrl'),
      rssUrl: data.get('rssUrl'),
      visible: id ? data.get('visible') === 'on' : true,
    };
  };
  const friendImport = document.querySelector<HTMLFormElement>('[data-friend-import]');
  friendImport?.addEventListener('submit', (event) => {
    event.preventDefault();
    const payload = friendPayload(friendImport);
    void runAdminAction(friendImport, async () => {
      await sendAdminRequest('/api/admin/friends.json', 'POST', payload);
      window.location.hash = 'friends';
      return '友链已导入。';
    }, true);
  });
  friendImport?.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');
  document.querySelectorAll<HTMLFormElement>('[data-friend-id]').forEach((form) => {
    const id = Number(form.dataset.friendId);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const payload = friendPayload(form, id);
      void runAdminAction(form, async () => {
        form.classList.remove('is-saved');
        await sendAdminRequest('/api/admin/friends.json', 'PATCH', payload);
        form.classList.add('is-saved');
        const summary = form.closest('.admin-record-row');
        if (summary) { const heading = summary.querySelector('b'); if (heading) heading.textContent = String(payload.name || ''); const description = summary.querySelector('p'); if (description) description.textContent = String(payload.description || ''); }
        return '友链已保存。';
      });
    });
    form.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');
    form.querySelector('[data-delete-friend]')?.addEventListener('click', async () => {
      if (!await confirmAdminAction('确定删除这条友链吗？', '删除友链')) return;
      void runAdminAction(form, async () => {
        await sendAdminRequest('/api/admin/friends.json', 'DELETE', { id });
        form.closest<HTMLDialogElement>('dialog')?.close();
        (form.closest('.admin-record-row') || form).remove();
      });
    });
    const icon = form.querySelector<HTMLImageElement>('.admin-friend-card__icon img');
    if (icon) {
      icon.addEventListener('error', () => { icon.hidden = true; }, { once: true });
      if (icon.complete && icon.naturalWidth === 0) icon.hidden = true;
    }
  });
</script>
