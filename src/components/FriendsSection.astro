---
import { listFriends, type FriendGroup } from '../lib/friends';
import { getCachedFriendFeeds } from '../lib/friend-feeds';
import { serverConfig } from '../config/server';
import '../styles/friends.css';
import FriendApplication from './FriendApplication.astro';

interface Props { featured?: boolean; }
const { featured = false } = Astro.props;
const allFriends = listFriends();
const cachedFeeds = new Map((featured ? getCachedFriendFeeds() : []).map((entry) => [entry.id, entry]));
const friends = allFriends.map((friend) => ({
  ...friend,
  description: friend.description.replace(/[。.]+$/u, ''),
  latest: cachedFeeds.get(friend.id),
}));
const groupTitles: Record<FriendGroup, string> = { starred: '星标友链', recommended: '推荐友链', default: '默认友链', lost: '失联友链' };
const groups = featured ? [{ key: 'all', title: '', friends }] : Object.entries(groupTitles).map(([key, title]) => ({ key, title, friends: friends.filter((friend) => friend.group === key) }));
const friendStatusTimeout = Math.ceil(allFriends.length / serverConfig.friendStatusConcurrency) * serverConfig.friendStatusTimeoutMilliseconds + 2000;
---

<section class="friends-section shell" id="friends" aria-labelledby="friends-title" data-reveal data-status-timeout={friendStatusTimeout}>
    <header class="friends-section__header">
      <div><span class="section-kicker">FRIENDS</span><h2 class="section-title" id="friends-title">网站友链</h2></div>
      {featured && <a class="friends-more" href="/about#friends">全部友链<span aria-hidden="true">↗</span></a>}
      {!featured && <FriendApplication />}
    </header>
    <div class:list={['friends-layout', { 'friend-deck': featured }]} data-friend-deck={featured ? '' : undefined} tabindex={featured ? 0 : undefined} role={featured ? 'region' : undefined} aria-label={featured ? '网站友链卡组' : undefined} aria-describedby={featured ? 'friend-deck-instructions' : undefined}>
    {featured && <>
      <p class="sr-only" id="friend-deck-instructions">使用左右方向键、横向滑动或拖动切换友链，滑动期间暂停自动切换，悬停不影响自动播放。</p>
      <p class="sr-only" data-friend-deck-status aria-live="polite"></p>
    </>}
    <div class="friend-groups">
    {groups.map((group) => <section class="friend-group" data-friend-group={group.key} aria-labelledby={featured ? undefined : `friend-group-${group.key}`} hidden={(featured || group.key === 'lost') && !group.friends.length}>
    {!featured && <h3 class="friend-group__title" id={`friend-group-${group.key}`}>{group.title}</h3>}
    <div class:list={['friend-grid', { 'friend-deck__stage': featured }]} data-friend-deck-stage={featured ? '' : undefined}>
      {group.friends.map((friend) => (
        <article class="friend-card c2-shape" data-friend-card={friend.id} data-friend-group-key={friend.group} data-reordered={featured ? 'true' : undefined}>
          <span class="friend-card__paper c2-surface" aria-hidden="true"></span>
          <span class="friend-card__media c2-clip"><img class:list={['friend-card__background', { 'is-avatar-background': !friend.backgroundUrl }]} src={friend.backgroundUrl || friend.iconUrl} alt="" loading="lazy" referrerpolicy="no-referrer" data-friend-background data-fallback={friend.iconUrl} draggable={featured ? false : undefined} /></span>
          <span class="friend-card__icon c2-clip"><b>{friend.name.slice(0, 1)}</b><img src={friend.iconUrl} alt="" loading="lazy" referrerpolicy="no-referrer" data-friend-icon draggable={featured ? false : undefined} /></span>
          <div class="friend-card__body">
            <div class="friend-card__heading">
              <a class="friend-card__copy" href={friend.url} target="_blank" rel="noopener noreferrer"><strong class:list={{ 'starred-text': friend.starred }}>{friend.name}</strong></a>
              {friend.starred && <span class="friend-card__star starred-text" role="img" aria-label="星标友链">★</span>}
              {friend.rssUrl &&
                <a class="friend-card__rss c2-shape" href={friend.rssUrl} target="_blank" rel="noopener noreferrer" aria-label={`订阅 ${friend.name} 的 RSS`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="19" r="1.5" /><path pathLength="1" d="M5 11a8 8 0 0 1 8 8" /><path pathLength="1" d="M5 5a14 14 0 0 1 14 14" /></svg><span>RSS</span>
                </a>
              }
            </div>
            <small class="friend-card__description">{friend.description}</small>
          </div>
          {featured && <div class="friend-card__update" data-friend-update hidden={!friend.latest}>
            <a class="friend-card__update-title" data-friend-update-title href={friend.latest?.url} target="_blank" rel="noopener noreferrer">{friend.latest?.title}</a>
            <p data-friend-update-summary hidden={!friend.latest?.summary}>{friend.latest?.summary}</p>
          </div>}
          <span class="friend-card__footer">
            <span class="friend-card__status" data-friend-status={friend.id} data-state="unknown" role="status" aria-live="polite"><i aria-hidden="true"></i><span data-friend-status-label>状态未知</span></span>
          </span>
        </article>
      ))}
    </div>
    {!featured && <p class="friends-empty" data-friend-group-empty hidden={group.friends.length > 0}>暂无{group.title}。</p>}
    </section>)}
    {featured && <p class="friends-empty" hidden={friends.length > 0} data-friends-empty>还没有公开友链。</p>}
    </div>
    {featured && <>
      <div class="friend-deck__controls">
        <output data-friend-deck-count aria-label="当前友链位置" aria-live="off">1 / {friends.length}</output>
      </div>
    </>}
    </div>
  </section>

<script>
  import type { FriendFeedUpdate } from '../lib/friend-feeds';
  import type { FriendRecord } from '../lib/friends';
  import { initializeFriendDeck } from '../lib/home-friend-deck';
  const friendSection = document.querySelector<HTMLElement>('#friends');
  const friendCards = new Map([...document.querySelectorAll<HTMLElement>('[data-friend-card]')].map((card) => [Number(card.dataset.friendCard), card]));
  const groupSections = [...document.querySelectorAll<HTMLElement>('[data-friend-group]')];
  const deckRoot = friendSection?.querySelector<HTMLElement>('[data-friend-deck]');
  const deck = deckRoot ? initializeFriendDeck(deckRoot) : undefined;
  let pendingFriends: FriendRecord[] | undefined;
  // 完整列表保留焦点；首页卡组由控制器协调交互期间的数据更新。
  const reorderFriends = (friends: FriendRecord[]) => {
    if (!deck && document.activeElement?.closest('[data-friend-card]')) { pendingFriends = friends; return; }
    pendingFriends = undefined;
    const visibleIds = new Set<number>();
    friends.forEach((friend) => {
      const card = friendCards.get(friend.id);
      const group = groupSections.find((section) => section.dataset.friendGroup === (deck ? 'all' : friend.group));
      const grid = group?.querySelector<HTMLElement>('.friend-grid');
      if (!card || !grid) return;
      card.dataset.friendGroupKey = friend.group;
      card.dataset.reordered = 'true';
      card.hidden = false;
      visibleIds.add(friend.id);
      grid.append(card);
    });
    friendCards.forEach((card, id) => { if (!visibleIds.has(id)) card.hidden = true; });
    groupSections.forEach((group) => {
      const hasCards = Boolean(group.querySelector('.friend-card:not([hidden])'));
      group.hidden = Boolean((deck || group.dataset.friendGroup === 'lost') && !hasCards);
      const empty = group.querySelector<HTMLElement>('[data-friend-group-empty]');
      if (empty) empty.hidden = hasCards;
    });
    const empty = friendSection?.querySelector<HTMLElement>('[data-friends-empty]');
    if (empty) empty.hidden = visibleIds.size > 0;
  };
  friendSection?.addEventListener('focusout', () => queueMicrotask(() => {
    if (pendingFriends) reorderFriends(pendingFriends);
  }));
  const loadFriendFeeds = async () => {
    const timeout = Number(document.querySelector<HTMLElement>('[data-status-timeout]')?.dataset.statusTimeout) || 7000;
    try {
      const response = await fetch('/api/friends/feeds.json', { signal: AbortSignal.timeout(timeout) });
      if (!response.ok) throw new Error(`Friend feeds returned ${response.status}`);
      const { feeds, friends } = await response.json() as { feeds: FriendFeedUpdate[]; friends: FriendRecord[] };
      if (!Array.isArray(feeds) || !Array.isArray(friends)) throw new Error('Invalid friend feed response');
      const updateFeeds = () => {
        reorderFriends(friends);
        if (!deck) return;
        friendCards.forEach((card, id) => {
          const entry = feeds.find((feed) => feed.id === id);
          const update = card.querySelector<HTMLElement>('[data-friend-update]');
          const title = card.querySelector<HTMLAnchorElement>('[data-friend-update-title]');
          const summary = card.querySelector<HTMLElement>('[data-friend-update-summary]');
          if (!update || !title || !summary) return;
          const available = Boolean(entry?.title && /^https?:\/\//i.test(entry.url));
          update.hidden = !available;
          if (!available || !entry) return;
          title.href = entry.url; title.textContent = entry.title;
          summary.textContent = entry.summary; summary.hidden = !entry.summary;
        });
      };
      if (deck) deck.refresh(updateFeeds);
      else updateFeeds();
    } catch (error) { console.warn('Friend feeds unavailable', error); }
  };
  import type { FriendStatus } from '../lib/friend-status';
  document.querySelectorAll<HTMLImageElement>('[data-friend-icon]').forEach((image) => {
    const hideFailedIcon = () => { image.hidden = true; };
    image.addEventListener('error', hideFailedIcon, { once: true });
    if (image.complete && image.naturalWidth === 0) hideFailedIcon();
  });

  document.querySelectorAll<HTMLImageElement>('[data-friend-background]').forEach((image) => {
    const recoverBackground = () => {
      if (!image.classList.contains('is-avatar-background') && image.dataset.fallback) {
        image.classList.add('is-avatar-background');
        image.src = image.dataset.fallback;
      } else image.hidden = true;
    };
    image.addEventListener('error', recoverBackground);
    if (image.complete && image.naturalWidth === 0) recoverBackground();
  });

  const statusNodes = [...document.querySelectorAll<HTMLElement>('[data-friend-status]')];
  const statusLabels: Record<FriendStatus['status'], string> = { online: '访问流畅', slow: '响应较慢', offline: '状态未知', restricted: '状态未知', blocked: '状态未知' };
  const loadFriendStatuses = async () => {
    try {
      const response = await fetch('/api/friends/status.json', { cache: 'no-store', signal: AbortSignal.timeout(Number(friendSection?.dataset.statusTimeout)) });
      if (!response.ok) throw new Error(`Friend connectivity API failed: ${response.status}`);
      const result = await response.json() as { statuses: FriendStatus[]; friends: FriendRecord[] };
      if (!Array.isArray(result.statuses) || !Array.isArray(result.friends)) throw new Error('Invalid friend connectivity response');
      const updateStatuses = () => {
        reorderFriends(result.friends);
        const statuses = new Map(result.statuses.map((status) => [String(status.id), status]));
        statusNodes.forEach((node) => {
          const status = statuses.get(node.dataset.friendStatus || '');
          const label = node.querySelector('[data-friend-status-label]');
          if (!label) return;
          node.dataset.state = status?.status === 'online' || status?.status === 'slow' ? status.status : 'unknown';
          label.textContent = status ? statusLabels[status.status] || '状态未知' : '状态未知';
        });
      };
      if (deck) deck.refresh(updateStatuses);
      else updateStatuses();
    } catch (error) {
      console.warn('Friend connectivity display unavailable', error);
      statusNodes.forEach((node) => {
        node.dataset.state = 'unknown';
        const label = node.querySelector('[data-friend-status-label]');
        if (label) label.textContent = '状态未知';
      });
    }
  };
  if (friendSection && statusNodes.length) {
    const loadFriends = async () => {
      if (statusNodes.length) await loadFriendStatuses();
      if (friendCards.size) await loadFriendFeeds();
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void loadFriends();
      }, { rootMargin: '200px' });
      observer.observe(friendSection);
    } else void loadFriends();
  }

</script>
