---
import { siteConfig } from '../config/site';
import RssSubscription from './RssSubscription.astro';
import NetworkStatus from './NetworkStatus.astro';
import { version } from '../../package.json';

interface Props { showSignature?: boolean }
const { showSignature = true } = Astro.props;
import { signatureLetters } from '../lib/signature';

---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-identity">
      <a class="footer-brand" href="/">
        <span><span class="footer-copyright">© </span>SamsBlog</span>
      </a>
      <NetworkStatus />
    </div>
    <div class="footer-notes">
    {showSignature && <div class="footer-signature" data-footer-signature data-duration={siteConfig.signature.durationMilliseconds} data-stroke-pause={siteConfig.signature.strokePauseMilliseconds} data-visibility-threshold={siteConfig.signature.visibilityThreshold} data-easing={siteConfig.signature.easing} data-settle-duration={siteConfig.signature.settleDurationMilliseconds} data-character-duration={siteConfig.signature.versionCharacterDurationMilliseconds} data-character-stagger={siteConfig.signature.versionCharacterStaggerMilliseconds}>
      <svg data-signature-drawing viewBox="0 0 360 90" width="360" height="90" role="img" aria-label="SuperSam 手写签名">
        <defs>
          {signatureLetters.map((letter, index) => <mask id={`footer-signature-mask-${index}`} maskUnits="userSpaceOnUse" x="0" y="0" width="360" height="90">
            {letter.traces.map((trace) => <path class="signature-stroke" d={trace} data-letter={letter.letter} pathLength="1" />)}
          </mask>)}
        </defs>
        {signatureLetters.map((letter, index) => <path class="signature-ink" d={letter.ink} mask={`url(#footer-signature-mask-${index})`} />)}
      </svg>
      <span class="signature-version" aria-label={`网页版本 v${version}`}>
        {[...`v${version}`].map((character) => <span class="signature-version-character">{character}</span>)}
      </span>
    </div>}
    </div>
    <nav aria-label="页脚导航">
      <RssSubscription />
      <a href="/admin">管理</a>
    </nav>
  </div>
</footer>

<script>
  // 页脚进入视野时按笔迹顺序书写，离开后允许下次重播。
  document.querySelectorAll<HTMLElement>('[data-footer-signature]').forEach((signature) => {
    const strokes = [...signature.querySelectorAll<SVGPathElement>('.signature-stroke')];
    const duration = Number(signature.dataset.duration);
    const pause = Number(signature.dataset.strokePause);
    const threshold = Number(signature.dataset.visibilityThreshold);
    const easing = signature.dataset.easing;
    const drawing = signature.querySelector<SVGSVGElement>('[data-signature-drawing]')!;
    const versionCharacters = [...signature.querySelectorAll<HTMLElement>('.signature-version-character')];
    const settleDuration = Number(signature.dataset.settleDuration);
    const characterDuration = Number(signature.dataset.characterDuration);
    const characterStagger = Number(signature.dataset.characterStagger);
    const settleEasing = getComputedStyle(signature).getPropertyValue('--ease-out').trim();
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const motionIsDisabled = () => reducedMotion.matches || document.documentElement.classList.contains('motion-paused');
    let disabled = motionIsDisabled();
    let visible = false;
    let animations: Animation[] = [];
    const clearAnimations = () => {
      animations.forEach((animation) => animation.cancel());
      animations = [];
    };
    const writeSignature = () => {
      clearAnimations();
      if (disabled || document.hidden) return;
      const lengths = strokes.map((stroke) => stroke.getTotalLength());
      const totalLength = lengths.reduce((sum, length) => sum + length, 0);
      const strokePause = Math.min(pause, duration / (2 * Math.max(1, strokes.length - 1)));
      const drawingDuration = duration - strokePause * (strokes.length - 1);
      let elapsed = 0;
      // 所有笔画共用一条时间曲线，整段慢起、加速、慢收。
      animations = strokes.map((stroke, index) => {
        const strokeDuration = drawingDuration * lengths[index] / totalLength;
        const start = elapsed / duration;
        const end = Math.min(1, (elapsed + strokeDuration) / duration);
        const animation = stroke.animate([
          { strokeDashoffset: '1', offset: 0 },
          { strokeDashoffset: '1', offset: start },
          { strokeDashoffset: '0', offset: end },
          { strokeDashoffset: '0', offset: 1 },
        ], {
          duration,
          easing,
          fill: 'both',
        });
        elapsed += strokeDuration + strokePause;
        return animation;
      });
      // 落款写完后让出版本位置，最终以完整落款组居中。
      const shift = (signature.getBoundingClientRect().width - drawing.getBoundingClientRect().width) / 2;
      animations.push(drawing.animate([
        { transform: `translateX(${shift}px)` },
        { transform: 'translateX(0)' },
      ], { duration: settleDuration, delay: duration, easing: settleEasing, fill: 'both' }));
      versionCharacters.forEach((character, index) => {
        animations.push(character.animate([
          { opacity: 0, transform: 'translateY(.35em)', filter: 'blur(3px)' },
          { opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' },
        ], {
          duration: characterDuration,
          delay: duration + index * characterStagger,
          easing: settleEasing,
          fill: 'both',
        }));
      });
    };
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) {
        visible = false;
        clearAnimations();
      } else if (entry.intersectionRatio >= threshold && !visible) {
        visible = true;
        writeSignature();
      }
    }, { threshold: [0, threshold] });
    observer.observe(signature);
    const syncMotion = () => {
      const next = motionIsDisabled();
      if (next === disabled) return;
      disabled = next;
      if (disabled) clearAnimations();
      else if (visible) writeSignature();
    };
    reducedMotion.addEventListener('change', syncMotion);
    new MutationObserver(syncMotion).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', () => {
      if (disabled || !visible) return;
      if (document.hidden) animations.forEach((animation) => animation.pause());
      else if (animations.length) animations.forEach((animation) => animation.play());
      else writeSignature();
    });
  });
</script>
