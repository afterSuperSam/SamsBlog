---
import { siteConfig } from '../config/site';
import SocialIcon from './SocialIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const { showMotion = true } = Astro.props;
const isCurrentPage = (href: string) => currentPath === href
  || (href === '/content' && currentPath.startsWith('/articles/'))
  || (href !== '/' && !href.includes('#') && currentPath.startsWith(href));
---

<header class="site-header" data-site-header>
  <div class="header-identity">
    <a class="site-brand" href="/" aria-label="SamsBlog 首页">
      <img class="site-brand__avatar" src="/media/brand/logo.jpg" alt="" width="44" height="44" />
      <span class="site-brand__sticker" data-brand-sticker><img
        class="site-brand__wordmark"
        src="/media/branding/samsblog-wordmark-nav.webp"
        alt="SamsBlog"
        width="480"
        height="179"
      /></span>
    </a>
    <nav class="header-socials" aria-label="社交链接">
      <a class="header-social header-social--bilibili" href={siteConfig.social.bilibili} target="_blank" rel="noreferrer" aria-label="Bilibili">
        <SocialIcon name="bilibili" />
        <span>Bilibili</span>
      </a>
      <a class="header-social header-social--github" href={siteConfig.social.github} target="_blank" rel="noreferrer" aria-label="GitHub">
        <SocialIcon name="github" />
        <span>GitHub</span>
      </a>
      <button class="header-social header-social--qq" type="button" aria-label={`复制 QQ 号 ${siteConfig.social.qq}`} data-copy-qq data-qq={siteConfig.social.qq}>
        <SocialIcon name="qq" />
        <span role="status" data-copy-qq-label>QQ</span>
      </button>
      <a class="header-social header-social--town" href="https://moesam.com/" target="_blank" rel="noreferrer" aria-label="楹雾镇 · YingwuTown">
        <SocialIcon name="town" />
        <span>YingwuTown</span>
      </a>
    </nav>
  </div>
  <nav class="desktop-nav" aria-label="主要导航">
    {siteConfig.nav.map((item) => (
      <a href={item.href} aria-current={isCurrentPage(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <div class="header-actions">
    {showMotion && <button class="motion-toggle header-action" type="button" data-motion-toggle aria-pressed="false" aria-label="关闭动效"><span class="header-action__label" data-motion-action-label aria-hidden="true">关闭动效</span><span aria-hidden="true">✧</span></button>}
    <button class="menu-button" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-navigation" data-menu-button>
      <svg class="menu-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 8h16" /><path d="M4 16h16" />
      </svg>
    </button>
    <ThemeToggle />
  </div>
  <div class="mobile-menu" id="mobile-navigation" hidden data-mobile-menu>
    <nav aria-label="移动端导航">
      {siteConfig.nav.map((item) => (
        <a href={item.href} aria-current={isCurrentPage(item.href) ? 'page' : undefined}>
          <span>{item.label}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import { siteConfig } from '../config/site';
  import { motionDisabled } from '../lib/motion';
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuButton = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const mobileMenu = header?.querySelector<HTMLElement>('[data-mobile-menu]');
  const mobileViewport = window.matchMedia('(max-width: 1080px)');
  const sticker = header?.querySelector<HTMLElement>('[data-brand-sticker]');
  let stickerFrame = 0;
  const resetSticker = () => {
    cancelAnimationFrame(stickerFrame); stickerFrame = 0;
    sticker?.style.removeProperty('--sticker-x'); sticker?.style.removeProperty('--sticker-y'); sticker?.style.removeProperty('--sticker-light');
  };
  sticker?.addEventListener('pointermove', (event) => {
    if (event.pointerType !== 'mouse' || motionDisabled()) return;
    cancelAnimationFrame(stickerFrame);
    stickerFrame = requestAnimationFrame(() => {
      const bounds = sticker.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, (event.clientX - bounds.left) / bounds.width * 2 - 1));
      const y = Math.max(-1, Math.min(1, (event.clientY - bounds.top) / bounds.height * 2 - 1));
      sticker.style.setProperty('--sticker-x', `${-y * siteConfig.effects.pointerTiltDegrees}deg`);
      sticker.style.setProperty('--sticker-y', `${x * siteConfig.effects.pointerTiltDegrees}deg`);
      sticker.style.setProperty('--sticker-light', `${50 + x * 35}%`);
    });
  });
  sticker?.addEventListener('pointerleave', resetSticker);
  window.addEventListener('blur', resetSticker);

  // 移动选项面板的展开、外部关闭与焦点恢复。
  function setMenuOpen(open: boolean, restoreFocus = true) {
    if (!header || !menuButton || !mobileMenu) return;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    mobileMenu.hidden = !open;
    if (open) {
      mobileMenu.querySelector<HTMLAnchorElement>('a')?.focus();
    } else if (restoreFocus) {
      menuButton.focus();
    }
  }

  menuButton?.addEventListener('click', () => {
    setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
  });
  mobileMenu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
  });
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node) || mobileMenu?.hidden) return;
    if (!mobileMenu?.contains(event.target) && !menuButton?.contains(event.target)) setMenuOpen(false, false);
  });
  header?.addEventListener('focusout', (event) => {
    if (!(event.relatedTarget instanceof Node) || mobileMenu?.hidden) return;
    if (!mobileMenu?.contains(event.relatedTarget) && !menuButton?.contains(event.relatedTarget)) setMenuOpen(false, false);
  });
  document.addEventListener('keydown', (event) => {
    if (!menuButton || !mobileMenu || mobileMenu.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setMenuOpen(false);
    }
  });
  mobileViewport.addEventListener('change', ({ matches }) => {
    if (!matches && mobileMenu && !mobileMenu.hidden) {
      setMenuOpen(false, false);
      header?.querySelector<HTMLAnchorElement>('.desktop-nav a[aria-current="page"], .desktop-nav a')?.focus();
    }
  });

  let frame = 0;
  const heroBrand = document.querySelector<HTMLElement>('.hero-copy');
  const updateHeader = () => {
    frame = 0;
    if (!header) return;
    const progress = Math.min(1, Math.max(0, window.scrollY / 110));
    header.style.setProperty('--header-reveal', String(progress));
    header.classList.toggle('site-header--scrolled', progress > 0.04);
    if (heroBrand) header.classList.toggle('site-header--past-hero', heroBrand.getBoundingClientRect().bottom <= header.offsetHeight);
  };

  updateHeader();
  window.addEventListener('resize', updateHeader);
  window.addEventListener('scroll', () => {
    if (mobileMenu && !mobileMenu.hidden) setMenuOpen(false, false);
    if (frame) return;
    frame = window.requestAnimationFrame(updateHeader);
  }, { passive: true });

  const qqButton = header?.querySelector<HTMLButtonElement>('[data-copy-qq]');
  const qqLabel = qqButton?.querySelector<HTMLElement>('[data-copy-qq-label]');
  qqButton?.addEventListener('click', async () => {
    const qq = qqButton.dataset.qq || '';
    try {
      await navigator.clipboard.writeText(qq);
      if (qqLabel) qqLabel.textContent = '已复制';
    } catch {
      if (qqLabel) qqLabel.textContent = '复制失败';
    }
    window.setTimeout(() => { if (qqLabel) qqLabel.textContent = 'QQ'; }, 1600);
  });
</script>
