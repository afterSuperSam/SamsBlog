---
const showPinkHalo = Astro.url.pathname !== '/';
---

<div class="ambient-scene" aria-hidden="true" data-ambient-scene>
  <canvas class="ambient-silk" data-ambient-silk></canvas>
  <div class="ambient-atmosphere ambient-atmosphere--blue"><div class="ambient-halo ambient-halo--blue"></div></div>
  {showPinkHalo && <div class="ambient-atmosphere ambient-atmosphere--pink"><div class="ambient-halo ambient-halo--pink"></div></div>}

</div>

<style>
  .ambient-scene{position:fixed;inset:0;overflow:hidden;z-index:0;pointer-events:none;contain:strict}
  .ambient-silk{position:absolute;inset:0;width:100%;height:100%;opacity:0;pointer-events:none}
  .ambient-silk[data-silk-ready]{opacity:var(--ambient-silk-opacity)}
  .ambient-atmosphere{position:absolute;inset:0;opacity:var(--ambient-rest-strength);transition:opacity var(--ambient-shift-duration) var(--ease-out)}
  :global(.home-page[data-home-atmosphere="blue"]) .ambient-atmosphere--blue{opacity:1}
  :global(.motion-paused) .ambient-atmosphere{transition:none}
  .ambient-halo{--halo-opacity:calc(var(--ambient-halo-opacity) / var(--ambient-rest-strength));--halo-horizontal-offset:var(--ambient-halo-travel);position:absolute;width:var(--ambient-halo-size);aspect-ratio:1;border-radius:50%;opacity:var(--halo-opacity);background:radial-gradient(circle,color-mix(in srgb,var(--glow-blue) 75%,transparent),transparent 67%);animation:halo-drift var(--ambient-halo-duration) ease-in-out infinite alternate}
  .ambient-halo--blue{left:-22%;top:22%}.ambient-halo--pink{--halo-opacity:calc(var(--ambient-pink-halo-opacity) / var(--ambient-rest-strength));--halo-horizontal-offset:calc(var(--ambient-halo-travel) * -1);width:var(--ambient-pink-halo-size);right:-12%;bottom:-18%;background:radial-gradient(circle,var(--glow-pink),transparent 67%);animation-duration:var(--ambient-pink-halo-duration);animation-delay:-14s;animation-direction:alternate-reverse}
  @keyframes halo-drift{0%{transform:translate3d(0,0,0) scale(.94);opacity:calc(var(--halo-opacity) * .6)}50%{transform:translate3d(calc(var(--halo-horizontal-offset) * .4),calc(var(--ambient-halo-travel) * -.65),0) scale(1.08);opacity:var(--halo-opacity)}100%{transform:translate3d(var(--halo-horizontal-offset),calc(var(--ambient-halo-travel) * -1),0) scale(1.2);opacity:calc(var(--halo-opacity) * .8)}}
  :global(.page-hidden) .ambient-scene *{animation-play-state:paused!important}
  :global(.motion-paused) .ambient-scene{opacity:.4}
  @media(prefers-reduced-motion:reduce){.ambient-scene *{animation:none!important}.ambient-atmosphere{transition:none}.ambient-scene{opacity:.35}}
  @media(max-width:720px){.ambient-halo{width:80vw}.ambient-halo--pink{width:110vw;right:-35%;bottom:-8%}}
</style>

<script>
  // 全站动效偏好与页面可见性共用这一入口，独立于背景装饰。
  const motionButton = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let paused = false;
  const readMotionPreference = () => {
    try { paused = localStorage.getItem('samsblog-motion') === 'paused'; }
    catch (error) { console.warn('Motion preference unavailable', error); }
  };
  readMotionPreference();
  const syncMotion = () => {
    const disabled = paused || reducedMotion.matches;
    document.documentElement.classList.toggle('motion-paused', disabled);
    if (!motionButton) return;
    motionButton.disabled = reducedMotion.matches;
    motionButton.setAttribute('aria-pressed', String(disabled));
    motionButton.setAttribute('aria-label', reducedMotion.matches ? '已按系统设置减少动效' : disabled ? '开启动效' : '关闭动效');
    const actionLabel = motionButton.querySelector('[data-motion-action-label]');
    if (actionLabel) actionLabel.textContent = reducedMotion.matches ? '减少动效' : paused ? '开启动效' : '关闭动效';
  };
  document.documentElement.classList.toggle('page-hidden', document.hidden);
  syncMotion();
  reducedMotion.addEventListener('change', syncMotion);
  motionButton?.addEventListener('click', () => {
    paused = !paused;
    try { localStorage.setItem('samsblog-motion', paused ? 'paused' : 'running'); }
    catch (error) { console.warn('Motion preference unavailable', error); }
    syncMotion();
  });
  const syncVisibility = () => document.documentElement.classList.toggle('page-hidden', document.hidden);
  document.addEventListener('visibilitychange', syncVisibility);
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    readMotionPreference();
    syncVisibility();
    syncMotion();
  });
</script>

<script>
  import { initializeAmbientSilk } from '../lib/ambient-silk';
  const silkCanvas = document.querySelector<HTMLCanvasElement>('[data-ambient-silk]');
  if (silkCanvas) initializeAmbientSilk(silkCanvas);
</script>
