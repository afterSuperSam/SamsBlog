---
import SocialIcon from './SocialIcon.astro';
import '../styles/reader.css';
---
<dialog id="reader-menu" class="reader-menu reader-paper" data-reader-menu aria-labelledby="reader-menu-title">
  <header class="reader-menu__heading"><h2 id="reader-menu-title">读者</h2><button type="button" data-reader-close aria-label="关闭读者面板">×</button></header>
  <section data-reader-menu-login>
    <p class="reader-menu__intro">登录，留下有名字的纸条。</p>
    <form method="post" action="/api/reader/email-login.json" data-reader-menu-form novalidate>
      <label class="reader-field" for="reader-menu-email">邮箱<input id="reader-menu-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required disabled /></label>
      <div class="reader-code-row"><label class="reader-field" for="reader-menu-code">验证码<input id="reader-menu-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="六位数字" required disabled /></label><button type="button" data-reader-menu-send disabled>发送验证码</button></div>
      <button class="reader-submit" type="submit" disabled>登录 / 注册 <span aria-hidden="true">↗</span></button>
    </form>
    <div class="reader-menu__providers" role="group" aria-label="其他登录方式">
      <button type="button" data-reader-provider="google" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" stroke="none" d="M21.6 12.2c0-.7-.1-1.4-.2-2.1H12v4h5.4a4.6 4.6 0 0 1-2 3 6.2 6.2 0 1 1 .1-10.3l3-3A10.3 10.3 0 1 0 12 22.3c5.9 0 9.6-4.1 9.6-10.1Z" /></svg>Google</button>
      <button type="button" data-reader-provider="blogsclub" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 4h7l2 2 2-2h7v15h-7l-2 2-2-2H3V4Zm9 2v15M6 8h3m-3 4h3m6-4h3m-3 4h3" /></svg>BlogsClub</button>
      <button type="button" data-reader-provider="github" disabled><SocialIcon name="github" />GitHub</button>
      <button type="button" data-reader-passkey-login disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5" /><path d="m11.5 11.5 8 8 2-2m-6-2 2-2M7 7h.01" /></svg>Passkey</button>
    </div>
  </section>
  <section data-reader-menu-account hidden>
    <div class="reader-menu__identity"><div class="reader-avatar" aria-hidden="true"><span data-reader-menu-initial>读</span><img data-reader-menu-avatar hidden alt="" width="54" height="54" referrerpolicy="no-referrer" /></div><div><h3 data-reader-menu-name tabindex="-1">读者</h3><p data-reader-menu-method></p></div></div>
    <div class="reader-menu__actions"><a href="/reader">我的账号 <span aria-hidden="true">↗</span></a><button type="button" data-reader-menu-logout disabled>退出</button></div>
  </section>
  <p class="reader-feedback" data-reader-menu-feedback role="status" aria-live="polite" aria-atomic="true"></p>
  <noscript><p>登录需要启用 JavaScript。</p></noscript>
</dialog>
<script>
  import { initializeReaderMenu } from '../lib/reader-menu';
  initializeReaderMenu();
</script>
