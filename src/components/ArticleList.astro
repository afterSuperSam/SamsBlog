---
import { listArticles } from '../lib/articles';
import { articleExcerpt } from '../lib/markdown';
import { siteConfig } from '../config/site';
import '../styles/articles.css';

interface Props { featured?: boolean }
const { featured = false } = Astro.props;
const parameters = Astro.url.searchParams;
const selectedSource = ['original', 'repost'].includes(parameters.get('source') || '') ? parameters.get('source')! : '';
const selectedCategory = ['discussion', 'journal'].includes(parameters.get('category') || '') ? parameters.get('category')! : '';
const selectedSort = ['created-desc', 'created-asc', 'updated-desc', 'updated-asc'].includes(parameters.get('sort') || '') ? parameters.get('sort')! : 'created-desc';
const articles = listArticles();
if (!featured) articles.sort((first, second) => {
  const key = selectedSort.startsWith('updated') ? 'updatedAt' : 'createdAt';
  const comparison = Date.parse(first[key]) - Date.parse(second[key]) || first.id - second.id;
  return selectedSort.endsWith('asc') ? comparison : -comparison;
});
const matches = (article: typeof articles[number]) => featured || ((!selectedSource || article.source === selectedSource) && (!selectedCategory || article.category === selectedCategory));
const matchedArticles = articles.filter(matches);
const visibleArticles = featured ? articles.slice(0, siteConfig.articles.homepageCount) : articles;
const dateLabel = (value: string) => new Date(value).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false });
const filterGroups = [
  { name: 'sort', label: '排序', selected: selectedSort, options: [
    { value: 'created-desc', label: '最新发布' }, { value: 'created-asc', label: '最早发布' },
    { value: 'updated-desc', label: '最近编辑' }, { value: 'updated-asc', label: '最早编辑' },
  ] },
  { name: 'source', label: '来源', selected: selectedSource, options: [
    { value: '', label: '全部' }, { value: 'original', label: '原创' }, { value: 'repost', label: '搬运' },
  ] },
  { name: 'category', label: '分类', selected: selectedCategory, options: [
    { value: '', label: '全部' }, { value: 'discussion', label: '杂谈' }, { value: 'journal', label: '日志' },
  ] },
];
const selectedFilters = filterGroups.map((group) => {
  const option = group.options.find((option) => option.value === group.selected)!;
  return option.value ? option.label : `全部${group.label}`;
}).join(' · ');
---

{(!featured || visibleArticles.length > 0) && <section class:list={['articles-section', { 'articles-section--featured': featured }]} id={featured ? 'latest-article' : 'articles'} aria-labelledby={featured ? 'latest-article-title' : 'articles-title'} data-article-list={!featured ? '' : undefined}>
  <div class="shell" data-reveal>
    <header class="articles-heading">
      <div><span class="section-kicker">ARTICLES</span><h2 class="section-title" id={featured ? 'latest-article-title' : 'articles-title'}>{featured ? '最近写下' : '文章'}</h2></div>
      {featured && <a class="articles-more" href="/about#articles">全部文章 <span aria-hidden="true">↗</span></a>}
      {!featured && <span class="articles-heading__note" aria-hidden="true">moments ✧</span>}
    </header>
    <div class:list={['article-browser', { 'article-browser--filters': !featured && articles.length > 0 }]}>
    <div class="article-browser__main">
    <div class="article-grid" data-article-grid>
      {visibleArticles.map((article, index) => <article class:list={['article-card', { 'article-card--cover': article.coverUrl }]} data-article-card={article.id} hidden={!matches(article)} data-image-side={(featured ? index : matchedArticles.indexOf(article)) % 2 === 0 ? 'left' : 'right'} data-source={article.source} data-category={article.category} data-created={article.createdAt} data-updated={article.updatedAt}>
        <a class="article-card__link" href={`/articles/${article.id}`}>
          {article.coverUrl && <div class="article-card__cover" aria-hidden="true"><img class="article-card__glow" src={article.coverUrl} alt="" loading="lazy" referrerpolicy="no-referrer" /><img class="article-card__image" data-article-cover={article.id} src={article.coverUrl} alt="" loading="lazy" referrerpolicy="no-referrer" /></div>}
          <div class="article-card__copy">
            <div class="article-tags"><span>{article.source === 'original' ? '原创' : '搬运'}</span><span>{article.category === 'discussion' ? '杂谈' : '日志'}</span></div>
            <h3>{article.title}</h3>
            <p>{articleExcerpt(article.content)}</p>
            <footer><time datetime={article.createdAt}>{dateLabel(article.createdAt)}</time></footer>
          </div>
        </a>
      </article>)}
    </div>
    {!featured && <p class="articles-empty" data-article-empty hidden={matchedArticles.length > 0}><span aria-hidden="true">{articles.length ? '⌕' : '✎'}</span><span>{articles.length ? '还没有找到这样的文章' : '纸页已经铺好，等下一次落笔'}</span></p>}
    {!featured && articles.length > 0 && <p class="article-results" role="status" aria-live="polite" data-article-results>共 {matchedArticles.length} 篇文章</p>}
    </div>
    {!featured && articles.length > 0 && <aside class="article-filters" data-article-filters aria-label="文章筛选与排序">
      <button class="article-filters__toggle" type="button" aria-expanded="false" aria-controls="article-filter-groups" data-filter-toggle><span data-filter-summary>{selectedFilters}</span><span aria-hidden="true">⌄</span></button>
      <div class="article-filters__groups" id="article-filter-groups">
      {filterGroups.map((group) => <fieldset class="article-filters__group">
        <legend>{group.label}</legend>
        <div class="article-filters__options">{group.options.map((option) => <button type="button" data-filter-name={group.name} data-filter-value={option.value} aria-pressed={option.value === group.selected}>{option.label}<span aria-hidden="true">↗</span></button>)}</div>
      </fieldset>)}
      </div>
    </aside>}
    </div>
  </div>
</section>}

<script>
  import { animateMotion, animateContentHeight } from '../lib/motion';
  import { siteConfig } from '../config/site';
  // 已公开文章在页面内筛选、排序，无需额外请求。
  document.querySelectorAll<HTMLElement>('[data-article-list]').forEach((section) => {
    const filters = section.querySelector<HTMLElement>('[data-article-filters]');
    const grid = section.querySelector<HTMLElement>('[data-article-grid]');
    const empty = section.querySelector<HTMLElement>('[data-article-empty]');
    const result = section.querySelector<HTMLElement>('[data-article-results]');
    const cards = [...section.querySelectorAll<HTMLElement>('[data-article-card]')];
    if (!filters || !grid) return;
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('[data-filter-name]')];
    const toggle = filters.querySelector<HTMLButtonElement>('[data-filter-toggle]');
    const summary = filters.querySelector<HTMLElement>('[data-filter-summary]');
    filters.dataset.filtersReady = '';
    const setExpanded = (expanded: boolean) => animateContentHeight(filters, () => {
      filters.dataset.expanded = String(expanded);
      toggle?.setAttribute('aria-expanded', String(expanded));
    });
    toggle?.addEventListener('click', () => setExpanded(toggle.getAttribute('aria-expanded') !== 'true'));
    filters.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
      setExpanded(false);
      toggle.focus();
    });
    const values: Record<string, string> = Object.fromEntries(buttons.filter((button) => button.getAttribute('aria-pressed') === 'true').map((button) => [button.dataset.filterName!, button.dataset.filterValue!]));
    const filterArticles = () => {
      const positions = new Map(cards.filter((card) => !card.hidden).map((card) => [card, card.getBoundingClientRect()]));
      cards.forEach((card) => card.getAnimations().forEach((animation) => animation.cancel()));
      const { source, category, sort } = values;
      const [field, direction] = sort.split('-');
      let count = 0;
      cards.sort((first, second) => {
        const key = field === 'updated' ? 'updated' : 'created';
        const comparison = Date.parse(first.dataset[key] || '') - Date.parse(second.dataset[key] || '') || Number(first.dataset.articleCard) - Number(second.dataset.articleCard);
        return direction === 'asc' ? comparison : -comparison;
      }).forEach((card) => {
        card.hidden = Boolean(source && card.dataset.source !== source) || Boolean(category && card.dataset.category !== category);
        if (!card.hidden) {
          card.dataset.imageSide = count % 2 === 0 ? 'left' : 'right';
          count += 1;
        }
        grid.append(card);
      });
      if (empty) empty.hidden = count > 0;
      if (result) result.textContent = `共 ${count} 篇文章`;
      if (summary) summary.textContent = ['sort', 'source', 'category'].map((name) => {
        const selected = buttons.find((button) => button.dataset.filterName === name && button.getAttribute('aria-pressed') === 'true');
        const text = selected?.childNodes[0]?.textContent || '';
        return values[name] ? text : `全部${name === 'source' ? '来源' : '分类'}`;
      }).join(' · ');
      const easing = getComputedStyle(document.documentElement).getPropertyValue('--ease-out').trim();
      cards.filter((card) => !card.hidden).forEach((card) => {
        const previous = positions.get(card);
        const next = card.getBoundingClientRect();
        card.classList.remove('reveal-pending');
        card.dataset.reordered = 'true';
        animateMotion(card, [
          { translate: previous ? `${previous.left - next.left}px ${previous.top - next.top}px` : '0 16px', opacity: previous ? 1 : 0 },
          { translate: '0 0', opacity: 1 },
        ], { duration: siteConfig.articles.reorderMilliseconds, easing });
      });
      const url = new URL(location.href);
      Object.entries(values).forEach(([key, value]) => value && value !== 'created-desc' ? url.searchParams.set(key, value) : url.searchParams.delete(key));
      history.replaceState(history.state, '', url);
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      const name = button.dataset.filterName || '';
      if (!(name in values)) return;
      values[name] = button.dataset.filterValue || '';
      buttons.filter((option) => option.dataset.filterName === name).forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
      filterArticles();
    }));
  });
</script>
