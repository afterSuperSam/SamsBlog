<div class="network-status" data-network-status hidden>
  <button class="network-status__summary" type="button" aria-expanded="false" aria-controls="network-details" data-network-trigger>
    <span data-network-summary-latency></span>
  </button>
  <div class="network-status__details" id="network-details" hidden data-network-details>
    <div data-network-visitor hidden>
      <span>你的网络</span>
      <strong data-network-location hidden></strong>
      <small data-network-ip hidden></small>
    </div>
    <div>
      <span>当前站点</span>
      <strong data-network-domain>{Astro.url.host}</strong>
      <small data-network-latency></small>
    </div>
  </div>
</div>

<script>
  import { siteConfig } from '../config/site';
  const statusRoot = document.querySelector<HTMLElement>('[data-network-status]');
  const trigger = statusRoot?.querySelector<HTMLButtonElement>('[data-network-trigger]');
  const details = statusRoot?.querySelector<HTMLElement>('[data-network-details]');
  const visibilityTarget = statusRoot?.parentElement;
  const latencySamples: number[] = [];
  let measurementRunning = false;
  let measurementFinished = false;
  let visibilityObserver: IntersectionObserver | undefined;

  const setDetailsOpen = (open: boolean) => {
    trigger?.setAttribute('aria-expanded', String(open));
    if (details) details.hidden = !open;
  };
  trigger?.addEventListener('click', () => {
    setDetailsOpen(trigger.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !statusRoot?.contains(event.target)) setDetailsOpen(false);
  });
  statusRoot?.addEventListener('focusout', (event) => {
    if (!(event.relatedTarget instanceof Node) || !statusRoot.contains(event.relatedTarget)) setDetailsOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && details && !details.hidden) {
      setDetailsOpen(false);
      trigger?.focus();
    }
  });

  function canMeasureLatency() {
    if (document.hidden || !visibilityTarget?.getClientRects().length) return false;
    const rectangle = visibilityTarget.getBoundingClientRect();
    return rectangle.width > 0 && rectangle.height > 0
      && rectangle.bottom > 0 && rectangle.top < window.innerHeight
      && rectangle.right > 0 && rectangle.left < window.innerWidth;
  }

  async function measureLatency() {
    while (latencySamples.length < siteConfig.network.sampleCount) {
      if (!canMeasureLatency()) return null;
      const start = performance.now();
      const response = await fetch(`/api/ping.json?t=${Date.now()}`, { cache: 'no-store', signal: AbortSignal.timeout(siteConfig.network.timeoutMilliseconds) });
      if (!response.ok) throw new Error(`Latency probe returned ${response.status}`);
      latencySamples.push(Math.round(performance.now() - start));
    }
    return latencySamples.sort((a, b) => a - b)[Math.floor(latencySamples.length / 2)];
  }

  async function refreshNetwork() {
    if (!statusRoot || measurementRunning || measurementFinished || !canMeasureLatency()) return;
    measurementRunning = true;
    try {
      const latency = await measureLatency();
      if (latency === null) return;
      measurementFinished = true;
      statusRoot.querySelector<HTMLElement>('[data-network-summary-latency]')!.textContent = `${latency} ms`;
      statusRoot.querySelector<HTMLElement>('[data-network-latency]')!.textContent = `${latency} ms`;
      trigger?.setAttribute('aria-label', `站点延迟 ${latency} 毫秒，查看网络信息`);
      statusRoot.hidden = false;
    } catch (error) {
      measurementFinished = true;
      console.warn('Latency probe unavailable', error);
      statusRoot.hidden = true;
    } finally {
      measurementRunning = false;
      if (measurementFinished) {
        visibilityObserver?.disconnect();
        document.removeEventListener('visibilitychange', refreshWhenVisible);
        window.removeEventListener('resize', refreshWhenVisible);
        window.removeEventListener('pageshow', refreshWhenVisible);
        window.removeEventListener('scroll', refreshWhenVisible);
      }
    }
  }

  function refreshWhenVisible() {
    void refreshNetwork();
  }

  async function loadVisitorNetwork() {
    try {
      const response = await fetch('/api/network.json', { cache: 'no-store', signal: AbortSignal.timeout(siteConfig.network.timeoutMilliseconds) });
      if (!response.ok) throw new Error(`Network API returned ${response.status}`);
      const visitor = await response.json() as { location: string; maskedIp: string };
      const location = statusRoot?.querySelector<HTMLElement>('[data-network-location]');
      const ip = statusRoot?.querySelector<HTMLElement>('[data-network-ip]');
      if (location && visitor.location && visitor.location !== '位置未知') { location.textContent = visitor.location; location.hidden = false; }
      if (ip && visitor.maskedIp && visitor.maskedIp !== '未知') { ip.textContent = `IP ${visitor.maskedIp}`; ip.hidden = false; }
      const visitorGroup = statusRoot?.querySelector<HTMLElement>('[data-network-visitor]');
      if (visitorGroup) visitorGroup.hidden = Boolean(location?.hidden && ip?.hidden);
    } catch (error) { console.warn('Visitor network information unavailable', error); }
  }
  // 页脚宿主进入视口后才测速；窄屏隐藏或切到后台时保留样本，恢复可见后继续。
  if (visibilityTarget) {
    document.addEventListener('visibilitychange', refreshWhenVisible);
    window.addEventListener('resize', refreshWhenVisible);
    window.addEventListener('pageshow', refreshWhenVisible);
    if (typeof window.IntersectionObserver === 'function') {
      visibilityObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) refreshWhenVisible();
      });
      visibilityObserver.observe(visibilityTarget);
    } else {
      window.addEventListener('scroll', refreshWhenVisible, { passive: true });
      refreshWhenVisible();
    }
  }
  trigger?.addEventListener('click', () => { void loadVisitorNetwork(); }, { once: true });
</script>
