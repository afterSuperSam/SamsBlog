---
import { listArticleMetadata } from '../lib/articles';
import { siteConfig } from '../config/site';

interface Props { compact?: boolean; articles?: { id: number; title: string; updatedAt: string }[] }
const { compact = false, articles = listArticleMetadata() } = Astro.props;
const headingId = compact ? 'home-reading-trail-title' : 'reading-trail-title';
---

<section class:list={['reading-trail', { 'reading-trail--compact': compact }]} data-reveal data-reading-trail data-trail-articles={JSON.stringify(articles.map(({ id, title, updatedAt }) => ({ id, title, updatedAt })))} data-trail-limit={compact ? 1 : siteConfig.readingExtras.historyVisibleCount} hidden aria-labelledby={compact ? headingId : undefined} aria-label={!compact ? '最近阅读记录' : undefined}>
  {compact && <header><h2 id={headingId}>之前读到</h2></header>}
  <ol data-trail-list></ol>
</section>

<script>
  import { readReadingHistory, getReadingTrail } from '../lib/reading-history';
  import { siteConfig } from '../config/site';
  document.querySelectorAll<HTMLElement>('[data-reading-trail]').forEach((trail) => {
    const list = trail.querySelector<HTMLOListElement>('[data-trail-list]')!;
    const articles = JSON.parse(trail.dataset.trailArticles!) as { id: number; title: string; updatedAt: string }[];
    const renderTrail = () => {
      try {
        const history = getReadingTrail(readReadingHistory(), articles, Number(trail.dataset.trailLimit));
        list.replaceChildren(...history.map((record) => {
          const item = document.createElement('li');
          const link = document.createElement('a'); link.href = `/articles/${record.id}`; link.textContent = record.title;
          const date = document.createElement('time'); date.dateTime = new Date(record.visitedAt).toISOString();
          date.textContent = new Date(record.visitedAt).toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
          const progress = document.createElement('span'); progress.textContent = record.progress > 0 ? `读到 ${Math.round(record.progress * 100)}%` : '刚刚翻开';
          item.append(date, link, progress); return item;
        }));
        trail.hidden = !history.length;
      } catch (error) { console.warn('Reading trail unavailable', error); trail.hidden = true; }
    };
    renderTrail();
    window.addEventListener('pageshow', renderTrail);
    window.addEventListener('storage', (event) => { if (event.key === null || event.key === siteConfig.articleReading.positionStorageKey) renderTrail(); });
  });
</script>
