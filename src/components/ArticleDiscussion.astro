---
import { ensureCommentIdentity } from '../lib/comment-submissions';
import { listPublishedMessages } from '../lib/db';
import { replyNotificationsConfigured } from '../lib/reply-notifications';
import { readReaderSession } from '../lib/readers';
import PaperCheckbox from './PaperCheckbox.astro';
import MessageBody from './MessageBody.astro';
import MessageReplies from './MessageReplies.astro';
import MessageSignature from './MessageSignature.astro';
import '../styles/guestbook.css';
const { articleId } = Astro.props as { articleId: number };
const messages = listPublishedMessages(60, articleId);
const reader = readReaderSession(Astro.cookies);
ensureCommentIdentity(Astro.cookies, Astro.url);
const dateLabel = (date: string) => new Date(date).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
---
<section class="article-discussion c2-surface" id="comments" data-article-discussion data-article-id={articleId} aria-labelledby="comments-title">
  <MessageSignature />
  <header class="article-discussion__heading">
    <div><span class="section-kicker">COMMENTS</span><h2 id="comments-title">留下几句话</h2></div>
    <div class="article-discussion__actions">
      <div class="article-reactions" role="group" aria-label="对文章表态">{[{ value: 'like', label: '喜欢', icon: '♡' }, { value: 'helpful', label: '有帮助', icon: '✓' }, { value: 'inspired', label: '有启发', icon: '↗' }].map((reaction) => <button class="c2-surface" type="button" data-reaction={reaction.value} aria-pressed="false" disabled><span aria-hidden="true">{reaction.icon}</span>{reaction.label}<b data-reaction-count></b></button>)}</div>
      <p class="form-status" data-reaction-feedback role="status"></p>
    </div>
  </header>
  <form method="post" class="article-comment-form c2-surface" data-article-comment data-reader-authenticated={String(Boolean(reader))} data-draft-reader={reader?.id} novalidate>
    <div class="article-comment-form__heading"><span data-comment-target>写给这篇文章</span><button type="button" data-cancel-comment-reply hidden>取消回复</button></div>
    <blockquote class="comment-quote c2-surface" data-comment-quote hidden><b data-comment-quote-name></b><p data-comment-quote-content></p></blockquote>
    <p class="reader-comment-identity"><span data-comment-reader hidden={!reader}>以读者 <b>{reader?.displayName}</b> 的身份留言</span><span data-comment-anonymous hidden={Boolean(reader)}>匿名评论审核后公开，也可以先 <a href="/reader">登录读者身份</a>。</span></p>
    <label data-comment-nickname hidden={Boolean(reader)}><span>怎么称呼</span><input name="nickname" minlength="2" maxlength="48" required autocomplete="off" value={reader?.displayName || ''} readonly={Boolean(reader)} /></label>
    <label class="article-comment-form__body"><span>想说的话</span><textarea name="content" rows="3" minlength="2" maxlength="1000" data-character-maximum="500" required></textarea></label>
    <label data-comment-email hidden={Boolean(reader)}><span>邮箱 · 可选，不公开</span><input name="email" type="text" inputmode="email" maxlength="254" autocomplete="off" /></label>
    <div class="visitor-preferences">
      {replyNotificationsConfigured && <PaperCheckbox name="notifyReply">验证邮箱后接收回复通知</PaperCheckbox>}
      <PaperCheckbox remember>记住称呼和邮箱</PaperCheckbox>
    </div>
    <small data-remember-status role="status"></small>
    <label hidden aria-hidden="true">网站<input name="website" tabindex="-1" autocomplete="off" /></label>
    <footer><button type="submit" class="articles-more" disabled>发表</button></footer>
    <p class="form-status" data-comment-feedback role="status" aria-live="polite"></p>
  </form>
  <div class="article-comments" data-comment-list>{messages.map((message) => <article class="article-comment c2-surface" id={`comment-${message.id}`} data-message-id={message.id} data-comment-root={message.id} data-message-name={message.nickname}><header><b>{message.nickname}</b><time datetime={message.createdAt}>{dateLabel(message.createdAt)}</time><button type="button" data-comment-reply={message.id} data-comment-message={message.id} data-comment-name={message.nickname}>回复</button></header><MessageBody content={message.content} /><MessageReplies replies={message.replies} parentId={message.id} interactive /></article>)}</div>
  <p class="article-comments-empty" data-comments-empty hidden={messages.length > 0}>还没有评论，写下第一句话吧。</p>
  <noscript><p>发表评论和表态需要启用 JavaScript。</p></noscript>
</section>
<script>
  import { requestJson } from '../lib/client-request';
  import { setFeedbackText } from '../lib/motion';
  import { attachPaperCaret } from '../lib/paper-caret';
  import { rememberVisitor } from '../lib/visitor-profile';
  import { initializeCommentInput } from '../lib/comment-tools';
  import { initializeCommentDraft } from '../lib/comment-drafts';
  import { setTaskFeedback } from '../lib/micro-feedback';
  import { renderCommentList } from '../lib/comment-rendering';
  import { siteConfig } from '../config/site';
  import type { MessageRecord } from '../lib/db';
  const root = document.querySelector<HTMLElement>('[data-article-discussion]');
  if (root) {
    const articleId = Number(root.dataset.articleId);
    const form = root.querySelector<HTMLFormElement>('[data-article-comment]')!;
    const visitor = rememberVisitor(form);
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    const feedback = root.querySelector<HTMLElement>('[data-comment-feedback]')!;
    const target = root.querySelector<HTMLElement>('[data-comment-target]')!;
    const cancel = root.querySelector<HTMLButtonElement>('[data-cancel-comment-reply]')!;
    const content = field('content') as HTMLTextAreaElement;
    const inputTools = initializeCommentInput(form, content);
    const drafts = initializeCommentDraft(content, `article:${articleId}`, Number(form.dataset.draftReader) || null);
    const quoteBox = root.querySelector<HTMLElement>('[data-comment-quote]')!;
    let quoteMessageId: number | null = null;
    let quoteContent = '';
    let selectedQuote: { id: number; text: string } | undefined;
    let parentId: number | null = null;
    let replyTargetId: number | null = null;
    let composing = false;
    const refreshCaret = attachPaperCaret(content);
    const nickname = field('nickname') as HTMLInputElement;
    attachPaperCaret(nickname);
    let anonymousNickname = nickname.readOnly ? '' : nickname.value;
    document.addEventListener('reader:session', (event) => {
      const reader = (event as CustomEvent<{ id: number; displayName: string } | null>).detail;
      if (reader) {
        if (!nickname.readOnly) anonymousNickname = nickname.value;
        nickname.value = reader.displayName;
      } else if (nickname.readOnly) nickname.value = anonymousNickname;
      drafts.switchIdentity(reader?.id ?? null); restoreDraftReply();
      nickname.readOnly = Boolean(reader);
      form.dataset.readerAuthenticated = String(Boolean(reader));
      form.querySelector<HTMLElement>('[data-comment-nickname]')!.hidden = Boolean(reader);
      form.querySelector<HTMLElement>('[data-comment-email]')!.hidden = Boolean(reader);
      form.querySelector<HTMLElement>('[data-comment-reader]')!.hidden = !reader;
      form.querySelector<HTMLElement>('[data-comment-anonymous]')!.hidden = Boolean(reader);
      form.querySelector<HTMLElement>('[data-comment-reader] b')!.textContent = reader?.displayName || '';
      nickname.dispatchEvent(new Event('input'));
    });
    attachPaperCaret(field('email') as HTMLInputElement);
    content.addEventListener('compositionstart', () => { composing = true; });
    content.addEventListener('compositionend', () => { composing = false; });
    const resetReply = () => { parentId = null; replyTargetId = null; quoteMessageId = null; quoteContent = ''; selectedQuote = undefined; quoteBox.hidden = true; target.textContent = '写给这篇文章'; cancel.hidden = true; };
    const restoreDraftReply = () => {
      const targetId = drafts.target.split(':')[4];
      const button = targetId ? root.querySelector<HTMLButtonElement>(`[data-comment-message="${targetId}"]`) : null;
      resetReply();
      if (button) { parentId = Number(button.dataset.commentReply); replyTargetId = Number(button.dataset.commentMessage); target.textContent = `回复 ${button.dataset.commentName}`; cancel.hidden = false; }
      else drafts.switchTarget(`article:${articleId}:root`);
      const submissionState = drafts.submissionState;
      if (button && submissionState?.quoteMessageId === replyTargetId && submissionState.quoteContent) {
        quoteMessageId = submissionState.quoteMessageId; quoteContent = submissionState.quoteContent; quoteBox.hidden = false;
        quoteBox.querySelector('[data-comment-quote-name]')!.textContent = button.dataset.commentName || '';
        quoteBox.querySelector('[data-comment-quote-content]')!.textContent = quoteContent;
      }
    };
    restoreDraftReply();
    cancel.addEventListener('click', () => { resetReply(); drafts.switchTarget(`article:${articleId}:root`); });
    document.addEventListener('selectionchange', () => {
      const selection = window.getSelection();
      const anchor = selection?.anchorNode;
      const text = (anchor instanceof Element ? anchor : anchor?.parentElement)?.closest<HTMLElement>('[data-comment-text]');
      const message = text?.closest<HTMLElement>('[data-message-id]');
      const selected = selection?.toString().trim() || '';
      selectedQuote = message && root.contains(message) && selection?.focusNode && text?.contains(selection.focusNode)
        && selected && Array.from(selected).length <= siteConfig.discussion.quoteMaximumCharacters ? { id: Number(message.dataset.messageId), text: selected } : undefined;
      root.querySelectorAll<HTMLButtonElement>('[data-comment-message]').forEach((button) => { button.textContent = selectedQuote?.id === Number(button.dataset.commentMessage) ? '引用回复' : '回复'; });
    });
    root.addEventListener('pointerdown', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-comment-message]') : null;
      if (selectedQuote && Number(button?.dataset.commentMessage) === selectedQuote.id) event.preventDefault();
    });
    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-comment-reply]');
      if (!button) return;
      drafts.switchTarget(`article:${articleId}:reply:${button.dataset.commentReply}:${button.dataset.commentMessage}`);
      parentId = Number(button.dataset.commentReply); replyTargetId = Number(button.dataset.commentMessage); target.textContent = `回复 ${button.dataset.commentName}`; cancel.hidden = false;
      const quote = selectedQuote?.id === Number(button.dataset.commentMessage) ? selectedQuote : undefined;
      quoteMessageId = quote?.id ?? null; quoteContent = quote?.text || ''; quoteBox.hidden = !quote;
      quoteBox.querySelector<HTMLElement>('[data-comment-quote-name]')!.textContent = quote ? `引用 ${button.dataset.commentName}` : '';
      quoteBox.querySelector<HTMLElement>('[data-comment-quote-content]')!.textContent = quoteContent;
      content.focus(); form.scrollIntoView({ block: 'nearest' });
    });
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); if (submit.disabled || composing) return;
      const authenticated = form.dataset.readerAuthenticated === 'true';
      const email = authenticated ? '' : field('email')!.value.trim();
      const notifyReply = Boolean((field('notifyReply') as HTMLInputElement)?.checked);
      if (notifyReply && !authenticated && !email) { setTaskFeedback(feedback, '接收回复通知需要填写邮箱。', 'error'); field('email')!.focus(); return; }
      const body = { articleId, parentId, replyTargetId, quoteMessageId, quoteContent, nickname: authenticated ? '' : field('nickname')!.value.trim(), content: content.value.trim(), email: notifyReply ? email : '', notifyReply, website: field('website')!.value };
      const invalidName = !(field('nickname') as HTMLInputElement).readOnly && ([...body.nickname].length < 2 || [...body.nickname].length > 24);
      if (invalidName || [...body.content].length < 2 || [...body.content].length > 500) { setTaskFeedback(feedback, invalidName ? '称呼需要 2–24 个字符。' : '评论需要 2–500 个字符。', 'error'); (invalidName ? field('nickname')! : content).focus(); return; }
      submit.disabled = true; setTaskFeedback(feedback, '正在送出…', 'pending');
      let posted = false;
      try {
        const draftSnapshot = await drafts.captureSubmission(body);
        const published = await requestJson<{ error?: string; id?: number; status?: string; message?: string }>('/api/guestbook/messages.json', 'POST', { ...body, operationId: draftSnapshot.operationId, submissionIdentity: draftSnapshot.key.split('/')[0] }, '评论暂时无法送出，输入仍保留。'); posted = true;
        visitor.save();
        if (drafts.complete(draftSnapshot)) {
          inputTools.resize(); refreshCaret();
          if (parentId === body.parentId && replyTargetId === body.replyTargetId && quoteMessageId === body.quoteMessageId && quoteContent === body.quoteContent) { resetReply(); drafts.switchTarget(`article:${articleId}:root`); }
        }
        if (published.status !== 'published') { setTaskFeedback(feedback, published.message || '评论已送达，审核后会公开展示。', 'success'); return; }
        setTaskFeedback(feedback, published.message || '评论已发表，谢谢你的分享。', 'success');
        const result = await requestJson<{ error?: string; messages: MessageRecord[] }>(`/api/guestbook/messages.json?articleId=${articleId}`, 'GET', undefined, '评论已发表，刷新后可查看。');
        renderCommentList(root.querySelector<HTMLElement>('[data-comment-list]')!, result.messages, published.id);
        root.querySelector<HTMLElement>('[data-comments-empty]')!.hidden = result.messages.length > 0;
      } catch (error) { setTaskFeedback(feedback, posted ? '评论已发表，列表暂时无法更新，刷新后可查看。' : error instanceof Error ? error.message : '评论发送失败，输入仍保留。', posted ? 'success' : 'error'); }
      finally { submit.disabled = false; }
    });
    submit.disabled = false;
    window.addEventListener('pagehide', (event) => { if (!event.persisted) { drafts.destroy(); inputTools.destroy(); } });
    const reactions = [...root.querySelectorAll<HTMLButtonElement>('[data-reaction]')];
    const reactionFeedback = root.querySelector<HTMLElement>('[data-reaction-feedback]')!;
    const renderReactions = (state: { counts: Record<string, number>; selected: string }) => reactions.forEach((button) => { button.setAttribute('aria-pressed', String(button.dataset.reaction === state.selected)); button.querySelector('[data-reaction-count]')!.textContent = state.counts[button.dataset.reaction!] ? String(state.counts[button.dataset.reaction!]) : ''; });
    void requestJson<{ error?: string; counts: Record<string, number>; selected: string }>(`/api/articles/reactions.json?articleId=${articleId}`, 'GET', undefined, '暂时无法读取表态。').then(renderReactions).catch(() => { setFeedbackText(reactionFeedback, '表态暂时无法加载，可稍后重试。'); }).finally(() => reactions.forEach((button) => { button.disabled = false; }));
    reactions.forEach((button) => button.addEventListener('click', async () => {
      reactions.forEach((item) => { item.disabled = true; });
      try { const state = await requestJson<{ error?: string; counts: Record<string, number>; selected: string }>('/api/articles/reactions.json', 'POST', { articleId, reaction: button.getAttribute('aria-pressed') === 'true' ? '' : button.dataset.reaction }, '暂时无法记录表态。'); renderReactions(state); setFeedbackText(reactionFeedback, state.selected ? '收到你的心意了。' : '已取消表态。'); }
      catch (error) { setFeedbackText(reactionFeedback, error instanceof Error ? error.message : '操作失败，请稍后再试。'); }
      finally { reactions.forEach((item) => { item.disabled = false; }); }
    }));
  }
</script>
