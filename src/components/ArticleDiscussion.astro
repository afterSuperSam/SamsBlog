---
import { listPublishedMessages } from '../lib/db';
import { replyNotificationsConfigured } from '../lib/reply-notifications';
import PaperCheckbox from './PaperCheckbox.astro';
const { articleId } = Astro.props as { articleId: number };
const messages = listPublishedMessages(60, articleId);
const dateLabel = (date: string) => new Date(date).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
---
<section class="article-discussion" id="comments" data-article-discussion data-article-id={articleId} aria-labelledby="comments-title">
  <header class="article-discussion__heading">
    <div><span class="section-kicker">COMMENTS</span><h2 id="comments-title">留下几句话</h2></div>
    <div class="article-discussion__actions">
      <div class="article-reactions" role="group" aria-label="对文章表态">{[{ value: 'like', label: '喜欢', icon: '♡' }, { value: 'helpful', label: '有帮助', icon: '✓' }, { value: 'inspired', label: '有启发', icon: '↗' }].map((reaction) => <button type="button" data-reaction={reaction.value} aria-pressed="false" disabled><span aria-hidden="true">{reaction.icon}</span>{reaction.label}<b data-reaction-count></b></button>)}</div>
      <p class="form-status" data-reaction-feedback role="status"></p>
    </div>
  </header>
  <form method="post" class="article-comment-form" data-article-comment novalidate>
    <div class="article-comment-form__heading"><span data-comment-target>写给这篇文章</span><button type="button" data-cancel-comment-reply hidden>取消回复</button></div>
    <label><span>怎么称呼</span><input name="nickname" minlength="2" maxlength="48" required autocomplete="off" /></label>
    <label class="article-comment-form__body"><span>想说的话</span><textarea name="content" rows="3" minlength="2" maxlength="1000" required></textarea></label>
    <label><span>邮箱 · 可选，不公开</span><input name="email" type="text" inputmode="email" maxlength="254" autocomplete="off" /></label>
    <div class="visitor-preferences">
      {replyNotificationsConfigured && <PaperCheckbox name="notifyReply">收到回复邮件通知</PaperCheckbox>}
      <PaperCheckbox remember>记住称呼和邮箱</PaperCheckbox>
    </div>
    <small data-remember-status role="status"></small>
    <label hidden aria-hidden="true">网站<input name="website" tabindex="-1" autocomplete="off" /></label>
    <footer><button type="submit" class="articles-more" disabled>发表</button></footer>
    <p class="form-status" data-comment-feedback role="status" aria-live="polite"></p>
  </form>
  <div class="article-comments" data-comment-list>{messages.map((message) => <article class="article-comment" id={`comment-${message.id}`}><header><b>{message.nickname}</b><time datetime={message.createdAt}>{dateLabel(message.createdAt)}</time><button type="button" data-comment-reply={message.id} data-comment-name={message.nickname}>回复</button></header><p>{message.content}</p>{message.replies?.map((reply) => <div class:list={['article-comment__reply', { 'is-owner': reply.isAdmin }]}><b>{reply.isAdmin ? 'Sam' : reply.nickname}</b><p>{reply.content}</p></div>)}</article>)}</div>
  <p class="article-comments-empty" data-comments-empty hidden={messages.length > 0}>还没有评论，写下第一句话吧。</p>
  <noscript><p>发表评论和表态需要启用 JavaScript。</p></noscript>
</section>
<script>
  import { requestJson } from '../lib/client-request';
  import { setFeedbackText } from '../lib/motion';
  import { attachPaperCaret } from '../lib/paper-caret';
  import { rememberVisitor } from '../lib/visitor-profile';
  import type { MessageRecord } from '../lib/db';
  const root = document.querySelector<HTMLElement>('[data-article-discussion]');
  if (root) {
    const articleId = Number(root.dataset.articleId);
    const form = root.querySelector<HTMLFormElement>('[data-article-comment]')!;
    const visitor = rememberVisitor(form);
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    const feedback = root.querySelector<HTMLElement>('[data-comment-feedback]')!;
    const target = root.querySelector<HTMLElement>('[data-comment-target]')!;
    const cancel = root.querySelector<HTMLButtonElement>('[data-cancel-comment-reply]')!;
    const content = field('content') as HTMLTextAreaElement;
    let parentId: number | null = null;
    let composing = false;
    const refreshCaret = attachPaperCaret(content);
    attachPaperCaret(field('nickname') as HTMLInputElement);
    attachPaperCaret(field('email') as HTMLInputElement);
    content.addEventListener('compositionstart', () => { composing = true; });
    content.addEventListener('compositionend', () => { composing = false; });
    const resetReply = () => { parentId = null; target.textContent = '写给这篇文章'; cancel.hidden = true; };
    cancel.addEventListener('click', resetReply);
    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-comment-reply]');
      if (!button) return;
      parentId = Number(button.dataset.commentReply); target.textContent = `回复 ${button.dataset.commentName}`; cancel.hidden = false;
      content.focus(); form.scrollIntoView({ block: 'nearest' });
    });
    const renderMessages = (messages: MessageRecord[]) => {
      const list = root.querySelector<HTMLElement>('[data-comment-list]')!;
      list.replaceChildren(...messages.map((message) => {
        const article = document.createElement('article'); article.className = 'article-comment'; article.id = `comment-${message.id}`;
        const header = document.createElement('header'); const name = document.createElement('b'); name.textContent = message.nickname;
        const date = document.createElement('time'); date.dateTime = message.createdAt; date.textContent = new Date(message.createdAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        const reply = document.createElement('button'); reply.type = 'button'; reply.textContent = '回复'; reply.dataset.commentReply = String(message.id); reply.dataset.commentName = message.nickname;
        const copy = document.createElement('p'); copy.textContent = message.content; header.append(name, date, reply); article.append(header, copy);
        for (const item of message.replies || []) { const row = document.createElement('div'); row.className = `article-comment__reply${item.isAdmin ? ' is-owner' : ''}`; const author = document.createElement('b'); author.textContent = item.isAdmin ? 'Sam' : item.nickname; const text = document.createElement('p'); text.textContent = item.content; row.append(author, text); article.append(row); }
        return article;
      }));
      root.querySelector<HTMLElement>('[data-comments-empty]')!.hidden = messages.length > 0;
    };
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); if (submit.disabled || composing) return;
      const email = field('email')!.value.trim();
      const notifyReply = Boolean((field('notifyReply') as HTMLInputElement)?.checked && email);
      const body = { articleId, parentId, nickname: field('nickname')!.value.trim(), content: content.value.trim(), email: notifyReply ? email : '', notifyReply, website: field('website')!.value };
      const invalidName = [...body.nickname].length < 2 || [...body.nickname].length > 24;
      if (invalidName || [...body.content].length < 2 || [...body.content].length > 500) { setFeedbackText(feedback, invalidName ? '称呼需要 2–24 个字符。' : '评论需要 2–500 个字符。'); (invalidName ? field('nickname')! : content).focus(); return; }
      submit.disabled = true; setFeedbackText(feedback, '正在送出…');
      let posted = false;
      try {
        await requestJson('/api/guestbook/messages.json', 'POST', body, '评论暂时无法送出，输入仍保留。'); posted = true;
        visitor.save();
        if (!composing && content.value.trim() === body.content) { content.value = ''; refreshCaret(); resetReply(); }
        setFeedbackText(feedback, '评论已发表，谢谢你的分享。');
        const result = await requestJson<{ error?: string; messages: MessageRecord[] }>(`/api/guestbook/messages.json?articleId=${articleId}`, 'GET', undefined, '评论已发表，刷新后可查看。');
        renderMessages(result.messages);
      } catch (error) { setFeedbackText(feedback, posted ? '评论已发表，列表暂时无法更新，刷新后可查看。' : error instanceof Error ? error.message : '评论发送失败，输入仍保留。'); }
      finally { submit.disabled = false; }
    });
    submit.disabled = false;
    const reactions = [...root.querySelectorAll<HTMLButtonElement>('[data-reaction]')];
    const reactionFeedback = root.querySelector<HTMLElement>('[data-reaction-feedback]')!;
    const renderReactions = (state: { counts: Record<string, number>; selected: string }) => reactions.forEach((button) => { button.setAttribute('aria-pressed', String(button.dataset.reaction === state.selected)); button.querySelector('[data-reaction-count]')!.textContent = state.counts[button.dataset.reaction!] ? String(state.counts[button.dataset.reaction!]) : ''; });
    void requestJson<{ error?: string; counts: Record<string, number>; selected: string }>(`/api/articles/reactions.json?articleId=${articleId}`, 'GET', undefined, '暂时无法读取表态。').then(renderReactions).catch(() => { setFeedbackText(reactionFeedback, '表态暂时无法加载，可稍后重试。'); }).finally(() => reactions.forEach((button) => { button.disabled = false; }));
    reactions.forEach((button) => button.addEventListener('click', async () => {
      reactions.forEach((item) => { item.disabled = true; });
      try { const state = await requestJson<{ error?: string; counts: Record<string, number>; selected: string }>('/api/articles/reactions.json', 'POST', { articleId, reaction: button.getAttribute('aria-pressed') === 'true' ? '' : button.dataset.reaction }, '暂时无法记录表态。'); renderReactions(state); setFeedbackText(reactionFeedback, state.selected ? '收到你的心意了。' : '已取消表态。'); }
      catch (error) { setFeedbackText(reactionFeedback, error instanceof Error ? error.message : '操作失败，请稍后再试。'); }
      finally { reactions.forEach((item) => { item.disabled = false; }); }
    }));
  }
</script>
