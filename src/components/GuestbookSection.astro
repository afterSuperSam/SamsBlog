---
import { listPublishedMessages } from '../lib/db';
import '../styles/guestbook.css';

const messages = listPublishedMessages();
const dateFormatter = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<section class="home-guestbook" id="guestbook">
  <div class="shell" data-reveal>
    <header class="home-guestbook__header">
      <span>GUESTBOOK</span>
      <h2>留言纸条</h2>
    </header>

    <div class="guestbook-layout">
      <form class="message-form" data-message-form autocomplete="off" novalidate>
        <span class="message-form__decor" aria-hidden="true"><i>✿</i><i>✧</i><i>✦</i></span>
        <div class="message-form__title">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 5.5h16v11H8l-4 3v-14Z" /><path d="M8 10h8M8 13h5" /></svg>
          </span>
          <h3>写一张小纸条</h3>
        </div>
        <label>
          <span>怎么称呼你</span>
          <input name="nickname" type="text" minlength="2" maxlength="24" autocomplete="off" spellcheck="false" placeholder="2–24 个字符" aria-required="true" aria-describedby="message-form-status" />
        </label>
        <label>
          <span>想说的话</span>
          <textarea name="content" minlength="2" maxlength="500" rows="4" autocomplete="off" spellcheck="false" aria-required="true" aria-describedby="message-form-status"></textarea>
        </label>
        <label class="message-form__honeypot" aria-hidden="true" hidden>
          <span>网站</span><input name="website" tabindex="-1" autocomplete="off" />
        </label>
        <div class="message-form__footer">
          <span><b data-message-count>0</b> / 500</span>
          <button class="button button--primary message-submit" type="submit">
            <span>送出留言</span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 5 16 7-16 7 3-7-3-7Z" /><path d="M7 12h13" /></svg>
          </button>
        </div>
        <p class="form-status" id="message-form-status" role="status" data-form-status></p>
      </form>

      <div class="message-wall">
        <div class="message-wall__scroll" role="region" aria-label="留言列表，可滚动查看" tabindex="0" data-message-scroll>
        {messages.length === 0 ? (
          <div class="message-empty">
            <b>这里还很安静。</b>
            <p>如果愿意，你可以成为第一个留下纸条的人。</p>
          </div>
        ) : (
          <ol>
            {messages.map((message) => (
              <li class="message-item" data-reveal>
                <div class="message-item__note">
                  <header><b>{message.nickname}</b><time datetime={message.createdAt}>{dateFormatter.format(new Date(message.createdAt))}</time></header>
                  <p>{message.content}</p>
                  {message.replies?.map((reply) => (
                    <blockquote class="message-reply"><b>Sam</b><p>{reply.content}</p></blockquote>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createCharacters, animateCharacters, animateContentHeight } from '../lib/motion';
  import { siteConfig } from '../config/site';
  const form = document.querySelector<HTMLFormElement>('[data-message-form]');
  const nickname = form?.querySelector<HTMLInputElement>('input[name="nickname"]');
  const textarea = form?.querySelector<HTMLTextAreaElement>('textarea[name="content"]');
  const counter = form?.querySelector<HTMLElement>('[data-message-count]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const messageScroll = document.querySelector<HTMLElement>('[data-message-scroll]');
  const messageWall = messageScroll?.parentElement;
  if (form && messageScroll && messageWall) {
    const updateWall = () => {
      messageWall.style.height = `${form.offsetHeight}px`;
      const remaining = messageScroll.scrollHeight - messageScroll.clientHeight - messageScroll.scrollTop;
      messageWall.dataset.overflow = String(remaining > 1);
      messageScroll.tabIndex = messageScroll.scrollHeight > messageScroll.clientHeight + 1 ? 0 : -1;
    };
    messageScroll.addEventListener('scroll', updateWall, { passive: true });
    const wallObserver = new ResizeObserver(updateWall);
    wallObserver.observe(form);
    if (messageScroll.firstElementChild) wallObserver.observe(messageScroll.firstElementChild);
    updateWall();
  }
  let submitting = false;
  const showStatus = (text: string, state: string) => {
    if (!status) return;
    status.querySelectorAll('.reveal-character').forEach((character) => character.getAnimations().forEach((animation) => animation.cancel()));
    animateContentHeight(status, () => {
      if (!text) { status.replaceChildren(); delete status.dataset.state; return; }
      const announcement = document.createElement('span');
      announcement.className = 'sr-only';
      announcement.textContent = text;
      status.replaceChildren(announcement, ...createCharacters(text));
      status.dataset.state = state;
    });
    animateCharacters(status);
  };

  // 软键盘只调整页面视口，不重新聚焦或改写原生输入法选区。
  let viewportFrame = 0;
  const keepWritingVisible = () => {
    viewportFrame = 0;
    const field = document.activeElement;
    const viewport = window.visualViewport;
    if (!viewport || (field !== nickname && field !== textarea) || !(field instanceof HTMLElement)) return;
    const inset = siteConfig.interactions.keyboardInsetPixels;
    const bounds = field.getBoundingClientRect();
    const headerBottom = document.querySelector('.site-header')?.getBoundingClientRect().bottom || 0;
    const top = Math.max(viewport.offsetTop, headerBottom) + inset;
    const bottom = viewport.offsetTop + viewport.height - inset;
    const caret = field.closest('label')?.querySelector<HTMLElement>('.paper-caret:not([hidden])');
    const caretBounds = caret?.getBoundingClientRect() || bounds;
    const controlsBottom = Math.max(form?.querySelector('.message-form__footer')?.getBoundingClientRect().bottom || 0, status?.getBoundingClientRect().bottom || 0);
    const target = controlsBottom - caretBounds.top <= bottom - top
      ? { top: caretBounds.top, bottom: Math.max(caretBounds.bottom, controlsBottom) } : caretBounds;
    const overflow = target.bottom > bottom ? target.bottom - bottom : target.top < top ? target.top - top : 0;
    if (overflow) window.scrollBy({ top: overflow, behavior: 'instant' });
  };
  const scheduleWritingVisibility = () => {
    if (!viewportFrame) viewportFrame = requestAnimationFrame(keepWritingVisible);
  };
  window.visualViewport?.addEventListener('resize', scheduleWritingVisibility);
  form?.addEventListener('focusin', scheduleWritingVisibility);
  form?.addEventListener('input', scheduleWritingVisibility);

  // 手绘光标跟随真实插入点，原生文本框继续处理输入法、选区和滚动。
  [nickname, textarea].forEach((field) => {
    const label = field?.closest('label');
    if (!field || !label) return;
    const caret = document.createElement('span');
    caret.className = 'paper-caret';
    caret.setAttribute('aria-hidden', 'true');
    caret.hidden = true;
    label.append(caret);
    label.classList.add('has-paper-caret');
    const mirror = document.createElement('div');
    mirror.setAttribute('aria-hidden', 'true');
    mirror.style.cssText = 'position:fixed;left:-10000px;top:0;visibility:hidden;pointer-events:none;border:0;white-space:pre-wrap;overflow-wrap:break-word;';
    const before = document.createTextNode('');
    const marker = document.createElement('span');
    marker.style.cssText = 'display:inline-block;width:0;height:var(--paper-caret-height);vertical-align:middle;';
    const after = document.createTextNode('');
    mirror.append(before, marker, after);
    document.body.append(mirror);
    let frame = 0;
    let revealCaret = false;
    let composing = false;
    const updateCaret = () => {
      frame = 0;
      const reveal = revealCaret;
      revealCaret = false;
      if (composing || document.activeElement !== field || field.selectionStart !== field.selectionEnd) {
        caret.hidden = true;
        return;
      }
      const styles = getComputedStyle(field);
      mirror.style.font = styles.font;
      mirror.style.letterSpacing = styles.letterSpacing;
      mirror.style.padding = styles.padding;
      mirror.style.boxSizing = styles.boxSizing;
      mirror.style.width = `${field.clientWidth}px`;
      mirror.style.whiteSpace = field instanceof HTMLInputElement ? 'pre' : 'pre-wrap';
      const position = field.selectionStart || 0;
      before.data = field.value.slice(0, position);
      after.data = field.value.slice(position) || '\u200b';
      const markerBounds = marker.getBoundingClientRect();
      const mirrorBounds = mirror.getBoundingClientRect();
      const fieldBounds = field.getBoundingClientRect();
      const labelBounds = label.getBoundingClientRect();
      const verticalOffset = field instanceof HTMLInputElement ? Math.max(0, (field.clientHeight - parseFloat(styles.paddingTop) - parseFloat(styles.paddingBottom) - parseFloat(styles.lineHeight)) / 2) : 0;
      let x = markerBounds.left - mirrorBounds.left - field.scrollLeft;
      let y = markerBounds.top - mirrorBounds.top - field.scrollTop + verticalOffset;
      if (reveal) {
        const insetTop = parseFloat(styles.paddingTop);
        const insetBottom = parseFloat(styles.paddingBottom);
        if (y < insetTop) field.scrollTop = Math.max(0, field.scrollTop + y - insetTop);
        else if (y + markerBounds.height > field.clientHeight - insetBottom) field.scrollTop += y + markerBounds.height - field.clientHeight + insetBottom;
        if (field instanceof HTMLInputElement) {
          const insetLeft = parseFloat(styles.paddingLeft);
          const insetRight = parseFloat(styles.paddingRight);
          if (x < insetLeft) field.scrollLeft = Math.max(0, field.scrollLeft + x - insetLeft);
          else if (x + caret.offsetWidth > field.clientWidth - insetRight) field.scrollLeft += x + caret.offsetWidth - field.clientWidth + insetRight;
        }
        x = markerBounds.left - mirrorBounds.left - field.scrollLeft;
        y = markerBounds.top - mirrorBounds.top - field.scrollTop + verticalOffset;
      }
      caret.style.left = `${fieldBounds.left - labelBounds.left + x}px`;
      caret.style.top = `${fieldBounds.top - labelBounds.top + y}px`;
      caret.hidden = x < 0 || x > field.clientWidth || y < 0 || y + markerBounds.height > field.clientHeight;
      caret.getAnimations().forEach((animation) => { animation.currentTime = 0; });
    };
    const scheduleCaret = (reveal = false) => {
      revealCaret ||= reveal;
      if (!frame) frame = requestAnimationFrame(updateCaret);
    };
    ['focus', 'input', 'keyup', 'click', 'select'].forEach((event) => field.addEventListener(event, () => { if (!composing) scheduleCaret(true); }));
    field.addEventListener('compositionstart', () => {
      composing = true;
      field.dataset.composing = 'true';
      caret.hidden = true;
    });
    field.addEventListener('compositionend', () => {
      composing = false;
      delete field.dataset.composing;
      scheduleCaret();
    });
    field.addEventListener('scroll', () => scheduleCaret(), { passive: true });
    field.addEventListener('blur', () => { caret.hidden = true; composing = false; delete field.dataset.composing; });
    document.addEventListener('selectionchange', () => { if (!composing && document.activeElement === field) scheduleCaret(); });
    form?.addEventListener('reset', () => scheduleCaret(true));
    new ResizeObserver(() => scheduleCaret()).observe(field);
  });

  textarea?.addEventListener('input', () => { if (counter) counter.textContent = String(textarea.value.length); });
  [nickname, textarea].forEach((field) => {
    if (!field) return;
    field.setAttribute('writingsuggestions', 'false');
    field.addEventListener('input', () => {
      field.removeAttribute('aria-invalid');
      if (status?.dataset.state === 'invalid') showStatus('', '');
    });
  });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitting || nickname?.dataset.composing === 'true' || textarea?.dataset.composing === 'true') return;
    const invalidField = [nickname, textarea].find((field) => field && (field.value.trim().length < field.minLength || field.value.trim().length > field.maxLength));
    if (invalidField) {
      const label = invalidField.name === 'nickname' ? '称呼' : '留言';
      if (status) {
        showStatus(invalidField.value.trim().length === 0 ? `请先填写${label}。` : `${label}需要 ${invalidField.minLength} 至 ${invalidField.maxLength} 个字符。`, 'invalid');
      }
      invalidField.setAttribute('aria-invalid', 'true');
      invalidField.focus();
      return;
    }
    submitting = true;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    submit?.setAttribute('disabled', 'true');
    showStatus('正在送出…', 'loading');
    try {
      const response = await fetch('/api/guestbook/messages.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nickname: data.get('nickname'), content: data.get('content'), website: data.get('website') }),
      });
      if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('留言服务暂时不可用，请稍后重试。');
      const result = await response.json() as { ok?: boolean; message?: string; error?: string };
      if (!response.ok || !result.ok) throw new Error(result.error || '提交失败，请稍后重试。');
      form.reset();
      if (counter) counter.textContent = '0';
      showStatus(result.message || '留言已送出。', 'success');
    } catch (error) {
      showStatus(error instanceof TypeError ? '网络连接失败，请检查连接后重试。' : error instanceof Error ? error.message : '提交失败，请稍后重试。', 'error');
    } finally {
      submitting = false;
      submit?.removeAttribute('disabled');
    }
  });
</script>
