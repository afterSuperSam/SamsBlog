---
import { listPublishedMessages } from '../lib/db';
import { replyNotificationsConfigured } from '../lib/reply-notifications';
import PaperCheckbox from './PaperCheckbox.astro';
import FriendApplication from './FriendApplication.astro';
import MessageBody from './MessageBody.astro';
import MessageReplies from './MessageReplies.astro';
import MessageSignature from './MessageSignature.astro';
import '../styles/guestbook.css';

const messages = listPublishedMessages();
const dateFormatter = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' });
---

<section class="home-guestbook" id="guestbook">
  <MessageSignature />
  <div class="shell" data-reveal>
    <header class="home-guestbook__header">
      <div><span>GUESTBOOK</span><h2>留言纸条</h2></div>
      <FriendApplication />
    </header>

    <div class="guestbook-layout">
      <form method="post" class="message-form" data-message-form autocomplete="off" novalidate>
        <span class="message-form__decor" aria-hidden="true"><i>✿</i><i>✧</i><i>✦</i></span>
        <div class="message-form__title">
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 5.5h16v11H8l-4 3v-14Z" /><path d="M8 10h8M8 13h5" /></svg>
          </span>
          <h3>写一张小纸条</h3>
        </div>
        <label class="paper-input-label">
          <span>怎么称呼你</span>
          <input name="nickname" type="text" minlength="2" maxlength="48" data-character-maximum="24" autocomplete="off" spellcheck="false" placeholder="2–24 个字符" aria-required="true" aria-describedby="message-form-status" />
        </label>
        <label class="paper-input-label">
          <span>想说的话</span>
          <textarea name="content" minlength="2" maxlength="1000" data-character-maximum="500" rows="4" autocomplete="off" spellcheck="false" aria-required="true" aria-describedby="message-form-status"></textarea>
        </label>
        <label class="message-form__honeypot" aria-hidden="true" hidden>
          <span>网站</span><input name="website" tabindex="-1" autocomplete="off" />
        </label>
        <div class="message-contact">
          <label class="paper-input-label"><span>邮箱 · 可选，不公开</span><input name="email" type="text" inputmode="email" maxlength="254" autocomplete="off" /></label>
          <div class="visitor-preferences">
            {replyNotificationsConfigured && <PaperCheckbox name="notifyReply">收到回复邮件通知</PaperCheckbox>}
            <PaperCheckbox remember>记住称呼和邮箱</PaperCheckbox>
          </div>
          <small data-remember-status role="status"></small>
        </div>
        <div class="message-form__footer">
          <span><b data-message-count>0</b> / 500</span>
          <button class="button button--primary message-submit" type="submit" disabled>
            <span>送出留言</span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 5 16 7-16 7 3-7-3-7Z" /><path d="M7 12h13" /></svg>
          </button>
        </div>
        <p class="form-status" id="message-form-status" role="status" data-form-status></p>
        <div class="message-receipt" data-message-receipt aria-hidden="true" hidden>
          <div class="message-receipt__paper" data-receipt-paper>
            <i class="message-receipt__fold message-receipt__fold--top" data-receipt-top></i>
            <i class="message-receipt__fold message-receipt__fold--bottom" data-receipt-bottom></i>
            <strong class="message-receipt__stamp" data-receipt-stamp>已收到</strong>
          </div>
        </div>
        <noscript><p>留言需要启用 JavaScript 后才能提交。</p></noscript>
      </form>

      <div class="message-wall">
        <div class="message-wall__scroll" role="region" aria-label="留言列表，可滚动查看" tabindex="0" data-message-scroll>
        {messages.length === 0 ? (
          <div class="message-empty">
            <b>这里还很安静。</b>
            <p>如果愿意，你可以成为第一个留下纸条的人。</p>
          </div>
        ) : (
          <ol>
            {messages.map((message) => (
              <li class="message-item" data-reveal>
                <div class="message-item__note">
                  <header><b>{message.nickname}</b><time datetime={message.createdAt}>{dateFormatter.format(new Date(message.createdAt))}</time></header>
                  <MessageBody content={message.content} />
                  <MessageReplies replies={message.replies} parentId={message.id} />
                </div>
              </li>
            ))}
          </ol>
        )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { attachPaperCaret } from '../lib/paper-caret';
  import { createCharacters, animateCharacters, animateContentHeight, animateMotion, motionDisabled } from '../lib/motion';
  import { siteConfig } from '../config/site';
  import { requestJson } from '../lib/client-request';
  import { rememberVisitor } from '../lib/visitor-profile';
  import { initializeCommentInput } from '../lib/comment-tools';
  const form = document.querySelector<HTMLFormElement>('[data-message-form]');
  const visitor = form ? rememberVisitor(form) : undefined;
  const nickname = form?.querySelector<HTMLInputElement>('input[name="nickname"]');
  const textarea = form?.querySelector<HTMLTextAreaElement>('textarea[name="content"]');
  const inputTools = form && textarea ? initializeCommentInput(form, textarea) : undefined;
  const counter = form?.querySelector<HTMLElement>('[data-message-count]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const messageScroll = document.querySelector<HTMLElement>('[data-message-scroll]');
  const messageWall = messageScroll?.parentElement;
  const receipt = form?.querySelector<HTMLElement>('[data-message-receipt]');
  let receiptAnimations: Animation[] = [];
  const stopReceipt = () => {
    receiptAnimations.forEach((animation) => animation.cancel()); receiptAnimations = [];
    if (receipt) receipt.hidden = true;
  };
  // 只在成功且输入已安全清空后折信；继续输入或切走页面会立即恢复纸条。
  const showReceipt = async () => {
    stopReceipt();
    if (!form || !receipt || motionDisabled() || document.hidden) return;
    receipt.hidden = false;
    const duration = siteConfig.interactions.receiptDurationMilliseconds;
    const easing = getComputedStyle(form).getPropertyValue('--ease-out').trim();
    const play = (element: Element, frames: Keyframe[], start = 0, length = 1) => {
      const animation = animateMotion(element, frames.map((frame) => ({ ...frame, easing })), { duration: duration * length, delay: duration * start, fill: 'both' });
      if (animation) receiptAnimations.push(animation);
    };
    [...form.children].filter((element) => element !== receipt && element !== status).forEach((element) => play(element,
      [{ opacity: 1 }, { opacity: 0, offset: .14 }, { opacity: 0, offset: .8 }, { opacity: 1 }]));
    play(receipt.querySelector('[data-receipt-paper]')!, [
      { opacity: 0, transform: 'translateY(12px) scale(.92)' },
      { opacity: 1, transform: 'translateY(0) scale(1)', offset: .16 },
      { opacity: 1, transform: 'translateY(0) scale(1)', offset: .78 },
      { opacity: 0, transform: 'translateY(-18px) scale(.96)' },
    ]);
    play(receipt.querySelector('[data-receipt-top]')!, [{ transform: 'rotateX(0deg)' }, { transform: 'rotateX(-180deg)' }], .13, .28);
    play(receipt.querySelector('[data-receipt-bottom]')!, [{ transform: 'rotateX(0deg)' }, { transform: 'rotateX(180deg)' }], .28, .28);
    play(receipt.querySelector('[data-receipt-stamp]')!, [{ opacity: 0, transform: 'scale(1.5) rotate(-18deg)' }, { opacity: 1, transform: 'scale(1) rotate(-8deg)' }], .52, .2);
    await Promise.allSettled(receiptAnimations.map((animation) => animation.finished));
    stopReceipt();
  };
  form?.addEventListener('input', stopReceipt);
  form?.addEventListener('focusin', stopReceipt);
  document.addEventListener('visibilitychange', () => { if (document.hidden) stopReceipt(); });
  if (form && messageScroll && messageWall) {
    const updateWall = () => {
      messageWall.style.height = `${form.offsetHeight}px`;
      const remaining = messageScroll.scrollHeight - messageScroll.clientHeight - messageScroll.scrollTop;
      messageWall.dataset.overflow = String(remaining > 1);
      messageScroll.tabIndex = messageScroll.scrollHeight > messageScroll.clientHeight + 1 ? 0 : -1;
    };
    messageScroll.addEventListener('scroll', updateWall, { passive: true });
    const wallObserver = new ResizeObserver(updateWall);
    wallObserver.observe(form);
    if (messageScroll.firstElementChild) wallObserver.observe(messageScroll.firstElementChild);
    updateWall();
  }
  let submitting = false;
  const showStatus = (text: string, state: string) => {
    if (!status) return;
    status.querySelectorAll('.reveal-character').forEach((character) => character.getAnimations().forEach((animation) => animation.cancel()));
    animateContentHeight(status, () => {
      if (!text) { status.replaceChildren(); delete status.dataset.state; return; }
      const announcement = document.createElement('span');
      announcement.className = 'sr-only';
      announcement.textContent = text;
      status.replaceChildren(announcement, ...createCharacters(text));
      status.dataset.state = state;
    });
    animateCharacters(status);
  };

  // 软键盘只调整页面视口，不重新聚焦或改写原生输入法选区。
  let viewportFrame = 0;
  const keepWritingVisible = () => {
    viewportFrame = 0;
    const field = document.activeElement;
    const viewport = window.visualViewport;
    if (!viewport || (field !== nickname && field !== textarea) || !(field instanceof HTMLElement)) return;
    const inset = siteConfig.interactions.keyboardInsetPixels;
    const bounds = field.getBoundingClientRect();
    const headerBottom = document.querySelector('.site-header')?.getBoundingClientRect().bottom || 0;
    const top = Math.max(viewport.offsetTop, headerBottom) + inset;
    const bottom = viewport.offsetTop + viewport.height - inset;
    const caret = field.closest('label')?.querySelector<HTMLElement>('.paper-caret:not([hidden])');
    const caretBounds = caret?.getBoundingClientRect() || bounds;
    const controlsBottom = Math.max(form?.querySelector('.message-form__footer')?.getBoundingClientRect().bottom || 0, status?.getBoundingClientRect().bottom || 0);
    const target = controlsBottom - caretBounds.top <= bottom - top
      ? { top: caretBounds.top, bottom: Math.max(caretBounds.bottom, controlsBottom) } : caretBounds;
    const overflow = target.bottom > bottom ? target.bottom - bottom : target.top < top ? target.top - top : 0;
    if (overflow) window.scrollBy({ top: overflow, behavior: 'instant' });
  };
  const scheduleWritingVisibility = () => {
    if (!viewportFrame) viewportFrame = requestAnimationFrame(keepWritingVisible);
  };
  window.visualViewport?.addEventListener('resize', scheduleWritingVisibility);
  form?.addEventListener('focusin', scheduleWritingVisibility);
  form?.addEventListener('input', scheduleWritingVisibility);

  [nickname, textarea, form?.querySelector<HTMLInputElement>('[name="email"]')].forEach(attachPaperCaret);

  textarea?.addEventListener('input', () => { if (counter) counter.textContent = String(Array.from(textarea.value).length); });
  [nickname, textarea].forEach((field) => {
    if (!field) return;
    field.setAttribute('writingsuggestions', 'false');
    field.addEventListener('input', () => {
      field.removeAttribute('aria-invalid');
      if (status?.dataset.state === 'invalid') showStatus('', '');
    });
  });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitting || nickname?.dataset.composing === 'true' || textarea?.dataset.composing === 'true') return;
    const invalidField = [nickname, textarea].find((field) => field && (field.value.includes('\0') || Array.from(field.value.trim()).length < field.minLength || Array.from(field.value.trim()).length > Number(field.dataset.characterMaximum)));
    if (invalidField) {
      const label = invalidField.name === 'nickname' ? '称呼' : '留言';
      if (status) {
        showStatus(invalidField.value.includes('\0') ? `${label}不能包含空字符。` : invalidField.value.trim().length === 0 ? `请先填写${label}。` : `${label}需要 ${invalidField.minLength} 至 ${invalidField.dataset.characterMaximum} 个字符。`, 'invalid');
      }
      invalidField.setAttribute('aria-invalid', 'true');
      invalidField.focus();
      return;
    }
    submitting = true;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    const email = String(data.get('email') || '').trim();
    const notifyReply = data.has('notifyReply') && email.length > 0;
    submit?.setAttribute('disabled', 'true');
    showStatus('正在送出…', 'loading');
    try {
      const result = await requestJson<{ ok?: boolean; message?: string; error?: string }>(
        '/api/guestbook/messages.json', 'POST',
        { nickname: data.get('nickname'), content: data.get('content'), website: data.get('website'), email: notifyReply ? email : '', notifyReply },
        '留言服务暂时不可用，请稍后重试。',
      );
      if (!result.ok) throw new Error(result.error || '提交失败，请稍后重试。');
      visitor?.save();
      // 只清空本次送出后未变化的字段，不打断等待期间的新输入或中文组词。
      [nickname, textarea].forEach((field) => {
        if (!field || (field === nickname && visitor?.enabled()) || field.dataset.composing === 'true' || field.value !== data.get(field.name)) return;
        field.value = '';
        field.dispatchEvent(new Event('input', { bubbles: true }));
      });
      if (counter) counter.textContent = String(Array.from(textarea?.value || '').length);
      inputTools?.resize();
      showStatus(result.message || '留言已送出。', 'success');
      if (!textarea?.value) await showReceipt();
    } catch (error) {
      showStatus(error instanceof TypeError ? '网络连接失败，请检查连接后重试。' : error instanceof Error ? error.message : '提交失败，请稍后重试。', 'error');
    } finally {
      submitting = false;
      submit?.removeAttribute('disabled');
    }
  });
  form?.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');
</script>
