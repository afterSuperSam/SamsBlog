---
import { createReaderSurfacePath } from '../lib/reader-surface-geometry';
interface Props { name?: string; remember?: boolean }
const { name, remember = false } = Astro.props;
---
<label class="paper-checkbox">
  <input type="checkbox" name={name} data-remember-visitor={remember ? '' : undefined} checked />
  <svg viewBox="0 0 28 28" aria-hidden="true" fill="none">
    <path class="paper-checkbox__box" d={createReaderSurfacePath(20, 20, 6)} transform="translate(4 4)" />
    <path class="paper-checkbox__check" d="M7 14.5 Q9 16 11.5 19.5 Q16 12 23 7" pathLength="1" />
  </svg>
  <span><slot /></span>
</label>
