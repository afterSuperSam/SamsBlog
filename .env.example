PUBLIC_SITE_URL=https://blog.example.com
BLOG_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD_HASH=generate-with-pnpm-hash-admin
HOST=127.0.0.1
PORT=4321
BLOG_DATA_DIR=./data
MEDIA_MAX_BYTES=10485760
SITE_LAUNCHED_AT=2026-08-22
ANALYTICS_DEDUPLICATION_SECONDS=1800
ANALYTICS_VISITOR_PAGE_SIZE=20
ADMIN_MUTATION_LIMIT=120
ADMIN_MUTATION_WINDOW_SECONDS=60
PUBLIC_ACTIVITY_LIMIT=60
PUBLIC_ACTIVITY_WINDOW_SECONDS=60
PUBLIC_ACTIVITY_TRACKED_ADDRESSES=1000

FRIEND_STATUS_CACHE_SECONDS=300
FRIEND_STATUS_TIMEOUT_MILLISECONDS=5000
FRIEND_STATUS_SLOW_MILLISECONDS=1800
FRIEND_STATUS_CONCURRENCY=3
FRIEND_STATUS_MAX_REDIRECTS=3

# 回复通知可选；验证发信域名后填写，未配置时不展示通知选项
RESEND_API_KEY=
MAIL_FROM=blog@moesam.com
MAIL_REPLY_TO=blog@moesam.com
MAIL_ADMIN_TO=
RESEND_REPLY_TEMPLATE_ID=
RESEND_ADMIN_TEMPLATE_ID=
ARTICLE_AUTOSAVE_MILLISECONDS=1800

# 读者登录：客户端凭证仅写服务端环境，邮箱复用上面的 Resend 发信设置
# BlogsClub 审核通过后启用，回调为登记的 HTTPS 根路径（PUBLIC_SITE_URL + /）
# GitHub / Google 回调分别为 /api/reader/oauth/github/callback.json 和 /api/reader/oauth/google/callback.json
# Google 测试模式仅允许已登记的测试用户；生产 Passkey 需 HTTPS，绑定 PUBLIC_SITE_URL 的域名
READER_BLOGSCLUB_CLIENT_ID=
READER_BLOGSCLUB_CLIENT_SECRET=
READER_GITHUB_CLIENT_ID=
READER_GITHUB_CLIENT_SECRET=
READER_GOOGLE_CLIENT_ID=
READER_GOOGLE_CLIENT_SECRET=
READER_SESSION_SECONDS=2592000
READER_RECENT_AUTHENTICATION_SECONDS=900
READER_ACCOUNT_PAGE_SIZE=20
READER_PROFILE_SOURCE_LIMIT=30
READER_PASSKEY_CHALLENGE_SECONDS=300
READER_PASSKEY_MAXIMUM_COUNT=10
READER_PASSKEY_REQUEST_MAXIMUM_BYTES=65536
READER_PASSKEY_SOURCE_LIMIT=60
READER_PASSKEY_GLOBAL_LIMIT=2000
READER_OAUTH_SECONDS=600
READER_CODE_SECONDS=600
READER_CODE_ATTEMPTS=5
READER_EMAIL_COOLDOWN_SECONDS=60
READER_QUOTA_WINDOW_SECONDS=3600
READER_EMAIL_ADDRESS_LIMIT=5
READER_EMAIL_SOURCE_LIMIT=10
READER_EMAIL_GLOBAL_LIMIT=100
READER_VERIFY_SOURCE_LIMIT=30
READER_VERIFY_GLOBAL_LIMIT=1000
READER_OAUTH_SOURCE_LIMIT=30
READER_OAUTH_GLOBAL_LIMIT=1000
READER_REQUEST_MAXIMUM_BYTES=4096
READER_UPSTREAM_TIMEOUT_MILLISECONDS=8000
READER_UPSTREAM_MAXIMUM_BYTES=65536
